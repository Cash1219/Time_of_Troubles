										visible = "[Or(And(GetVariableSystem.HasValue('tot_kizuna_page', 'subject'), GetScriptedGui('tot_character_codex_show_subject_105').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), And(Not(GetVariableSystem.HasValue('tot_kizuna_page', 'subject')), GetScriptedGui('tot_character_codex_show_105').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
										onclick = "[GetScriptedGui('tot_character_codex_select_105').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										tooltip = "TOT_CHARACTER_CODEX_SCAN_GROUP"
									}
									button = {
										using = default_button
										size = { 196 34 }
										text = "tot_kizuna_106_codex_display"
										down = "[GetScriptedGui('tot_character_codex_select_106_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										visible = "[Or(And(GetVariableSystem.HasValue('tot_kizuna_page', 'subject'), GetScriptedGui('tot_character_codex_show_subject_106').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), And(Not(GetVariableSystem.HasValue('tot_kizuna_page', 'subject')), GetScriptedGui('tot_character_codex_show_106').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
										onclick = "[GetScriptedGui('tot_character_codex_select_106').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										tooltip = "TOT_CHARACTER_CODEX_SCAN_GROUP"
									}
								}
							}
						}
				}

				vbox = {
					size = { 1150 542 }
					spacing = 8
					hbox = {
						size = { 1150 28 }
						spacing = 8
						textbox = {
							size = { 1050 28 }
                            text = "TOT_CHARACTER_CODEX_RESULTS_CURRENT"
							using = fontsize_large
							align = left|nobaseline
						}
						textbox = {
							size = { 62 28 }
							text = "TOT_CHARACTER_CODEX_RESULT_COUNT"
							using = fontsize_large
							align = right|nobaseline
						}
					}
					scrollbox = {
						size = { 1150 500 }
						blockoverride "scrollbox_content" {
							fixedgridbox = {
								datamodel = "[GetPlayer.MakeScope.GetList('tot_character_codex_results')]"
								addcolumn = 364
								addrow = 136
								flipdirection = yes
								datamodel_wrap = 3
								item = { tot_kizuna_codex_character = {} }
							}
