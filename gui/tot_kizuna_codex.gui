types tot_kizuna_codex_types {
	type tot_kizuna_codex_character = widget {
		size = { 350 128 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"
		using = entry_bg_fancy

		tooltipwidget = {
			FancyTooltip_Character = {}
		}

		hbox = {
			margin = { 10 8 }
			spacing = 8

			widget = {
				size = { 108 112 }

				character_portrait_large = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
				}

				ig_button = {
					visible = "[Character.GetInterestGroup.IsValid]"
					datacontext = "[Character.GetInterestGroup]"
					parentanchor = bottom|left
					block "ig_button_size" { size = { 42 42 } }
					using = tooltip_ws
					blockoverride "in_government_icon" {}
				}

				icon = {
					datacontext = "[Character.GetIdeology]"
					parentanchor = bottom|right
				size = { 42 42 }
					texture = "[Ideology.GetTexture]"
					tooltipwidget = { FancyTooltip_Ideology = {} }
				}
			}

			vbox = {
				size = { 214 108 }
				parentanchor = vcenter
				spacing = 4

				hbox = {
					size = { 214 108 }
					spacing = 4

					vbox = {
						size = { 150 108 }
						spacing = 4

						textbox = {
							size = { 150 28 }
							position = { 8 0 }
							raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!"
							using = fontsize_large
							align = left|nobaseline
							elide = right
						}

						textbox = {
							size = { 150 20 }
							raw_text = "#title [Character.GetPrimaryRoleTitle]#!"
							using = fontsize_small
							align = left|nobaseline
							elide = right
						}

						button_standard = {
							size = { 140 28 }
							text = "TOT_CHARACTER_CODEX_RECRUIT_SUBJECT"
							visible = "[GetVariableSystem.HasValue('tot_kizuna_page', 'subject')]"
							enabled = "[GetScriptedGui('tot_character_codex_recruit_subject').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tot_subject_character', Character.MakeScope).End)]"
							onclick = "[GetScriptedGui('tot_character_codex_recruit_subject').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tot_subject_character', Character.MakeScope).End)]"
							tooltip = "[GetScriptedGui('tot_character_codex_recruit_subject').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tot_subject_character', Character.MakeScope).End)]"
						}
					}

					vbox = {
						size = { 60 108 }
						parentanchor = vcenter
						spacing = 2

						widget = {
							size = { 60 58 }
							small_flag_no_interact = {
								datacontext = "[Character.GetCountry]"
								parentanchor = center
								size = { 48 32 }
								blockoverride "tooltip" {}
							}
						}

						textbox = {
							size = { 60 28 }
							position = { 0 -6 }
							raw_text = "[Character.GetCountry.GetNameNoFormatting]"
							using = fontsize_small
							align = center|nobaseline
							elide = right
						}
					}
				}
			}
		}
	}

	type tot_kizuna_codex_page = widget {
		size = { 1420 630 }
		background = { using = entry_bg_fancy }

		vbox = {
			margin = { 18 16 }
			spacing = 12

			hbox = {
				size = { 1384 42 }
				textbox = {
					size = { 980 36 }
					text = "TOT_CHARACTER_CODEX_HEADER"
					visible = "[Not(GetVariableSystem.HasValue('tot_kizuna_page', 'subject'))]"
					using = fontsize_xl
					align = left|nobaseline
				}
				textbox = {
					size = { 980 36 }
					text = "TOT_CHARACTER_SUBJECT_HEADER"
					visible = "[GetVariableSystem.HasValue('tot_kizuna_page', 'subject')]"
					using = fontsize_xl
					align = left|nobaseline
				}
				button_standard = {
					size = { 260 30 }
					parentanchor = right
					text = "TOT_CHARACTER_CODEX_MANUAL_REFRESH"
					tooltip = "TOT_CHARACTER_CODEX_SCAN_GROUP"
					onclick = "[GetScriptedGui('tot_character_codex_scan_selected').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			hbox = {
				size = { 1384 542 }
				spacing = 14

				vbox = {
					size = { 220 542 }
					spacing = 8
					background = { using = dark_area }
					vbox = {
						size = { 196 28 }
						visible = "[Not(GetVariableSystem.HasValue('tot_kizuna_page', 'subject'))]"
						margin = { 12 6 }
						hbox = {
							size = { 196 28 }
							spacing = 2
							button_tab = {
								size = { 64 28 }
								text = "TOT_CHARACTER_CODEX_SCOPE_HOME"
								down = "[GetScriptedGui('tot_character_codex_scope_home_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('tot_character_codex_scope_home').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_tab = {
								size = { 64 28 }
								text = "TOT_CHARACTER_CODEX_SCOPE_BLOC"
								down = "[GetScriptedGui('tot_character_codex_scope_bloc_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('tot_character_codex_scope_bloc').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_tab = {
								size = { 64 28 }
								text = "TOT_CHARACTER_CODEX_SCOPE_OTHER"
								down = "[GetScriptedGui('tot_character_codex_scope_other_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('tot_character_codex_scope_other').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_tab = {
								size = { 64 28 }
								visible = no
							}
						}
					}
						scrollbox = {
							size = { 196 482 }
							blockoverride "scrollbox_content" {
								vbox = {
								direction = vertical
								spacing = 4
								textbox = {
									size = { 196 24 }
									text = "TOT_CHARACTER_CODEX_GROUPS_FACTIONS"
									visible = "[GetScriptedGui('tot_character_codex_scope_bloc_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									using = fontsize_small
									align = left|nobaseline
								}
									button = {
										using = default_button
										size = { 196 34 }
										text = "tot_kizuna_001_codex_display"
