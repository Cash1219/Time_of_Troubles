types tot_kizuna_codex_types {
	type tot_kizuna_codex_character = widget {
		size = { 530 128 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"
		using = entry_bg_fancy

		tooltipwidget = {
			FancyTooltip_Character = {}
		}

		hbox = {
			margin = { 12 8 }
			spacing = 12

			widget = {
				size = { 96 108 }

				character_portrait_large = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
				}

				ig_button = {
					visible = "[Character.GetInterestGroup.IsValid]"
					datacontext = "[Character.GetInterestGroup]"
					parentanchor = bottom|left
					block "ig_button_size" { size = { 32 32 } }
					using = tooltip_ws
					blockoverride "in_government_icon" {}
				}

				icon = {
					datacontext = "[Character.GetIdeology]"
					parentanchor = bottom|right
					size = { 32 32 }
					texture = "[Ideology.GetTexture]"
					tooltipwidget = { FancyTooltip_Ideology = {} }
				}
			}

			vbox = {
				size = { 398 108 }
				parentanchor = vcenter
				position = { 0 -4 }
				spacing = 4

				hbox = {
					size = { 398 52 }
					spacing = 8

					vbox = {
						size = { 300 50 }
						spacing = 2
						textbox = {
							size = { 300 26 }
							raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!"
							using = fontsize_large
							align = left|nobaseline
							elide = right
						}
						textbox = {
							size = { 300 18 }
							raw_text = "#title [Character.GetPrimaryRoleTitle]#!"
							using = fontsize_small
							align = left|nobaseline
							elide = right
						}
					}

					vbox = {
						size = { 90 52 }
						spacing = 1
						small_flag_no_interact = {
							datacontext = "[Character.GetCountry]"
							parentanchor = top|hcenter
							blockoverride "tooltip" {}
						}
						textbox = {
							size = { 90 18 }
							raw_text = "[Character.GetCountry.GetNameNoFormatting]"
							using = fontsize_small
							align = center|nobaseline
							elide = right
						}
					}
				}
			}
		}
	}

	type tot_kizuna_codex_page = widget {
		size = { 1420 630 }
		background = { using = entry_bg_fancy }

		vbox = {
			margin = { 18 16 }
			spacing = 12

			hbox = {
				size = { 1384 42 }
				textbox = {
					size = { 980 36 }
					text = "TOT_CHARACTER_CODEX_HEADER"
					using = fontsize_xl
					align = left|nobaseline
				}
				button_standard = {
					size = { 260 30 }
					parentanchor = right
					text = "TOT_CHARACTER_CODEX_MANUAL_REFRESH"
					tooltip = "TOT_CHARACTER_CODEX_SCAN_GROUP"
					onclick = "[GetScriptedGui('tot_character_codex_scan_selected').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			hbox = {
				size = { 1384 542 }
				spacing = 14

				vbox = {
					size = { 250 542 }
					spacing = 8
					background = { using = dark_area }
					textbox = {
						size = { 226 24 }
