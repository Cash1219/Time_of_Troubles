types tot_character_growth_types
{
	type tot_character_growth_governor_state = widget {
		size = { 520 116 }
		datacontext = "[Scope.GetState]"
		visible = "[Scope.GetState.IsValid]"

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			margin = { 12 10 }
			spacing = 12

			widget = {
				size = { 78 96 }

				character_portrait_medium = {
					visible = "[GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End)]"
					datacontext = "[State.MakeScope.Var('tot_province_governor').GetCharacter]"
					parentanchor = center
				}

				icon = {
					visible = "[Not(GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End))]"
					texture = "gfx/interface/icons/generic_icons/red_cross.dds"
					size = { 44 44 }
					parentanchor = center
				}
			}

			flowcontainer = {
				direction = vertical
				spacing = 4
				size = { 200 96 }

				textbox = {
					text = "[State.GetNameNoFormatting]"
					default_format = "#v"
					using = fontsize_medium
					size = { 200 30 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					visible = "[GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End)]"
					datacontext = "[State.MakeScope.Var('tot_province_governor').GetCharacter]"
					text = "[Character.GetFullNameNoFormatting]"
					using = fontsize_small
					size = { 200 24 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					visible = "[GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End)]"
					datacontext = "[State.MakeScope.Var('tot_province_governor').GetCharacter]"
					text = "[Character.GetPrimaryRoleTitle]"
					using = fontsize_small
					size = { 200 24 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					visible = "[Not(GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End))]"
					text = "TOT_PROVINCE_GOVERNOR_EMPTY"
					using = fontsize_small
					size = { 200 24 }
					align = left|nobaseline
					elide = right
				}
			}

			textbox = {
				parentanchor = vcenter
				text = "TOT_PROVINCE_GOVERNOR_EFFECTS"
				using = fontsize_small
				size = { 96 46 }
				align = center|nobaseline
				multiline = yes
			}

			button_standard = {
				parentanchor = vcenter
				size = { 98 42 }
				text = "TOT_CHARACTER_GROWTH_SELECT_STATE"
				onclick = "[GetScriptedGui('tot_character_growth_select_governor_state').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
				tooltip = "TOT_CHARACTER_GROWTH_SELECT_STATE_TOOLTIP"
					}
			}
	}

	type tot_character_growth_candidate = widget {
		size = { 500 122 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"

		background = {
			using = entry_bg_fancy
		}

		flowcontainer = {
			margin = { 12 10 }
			spacing = 12

			character_portrait_medium = {}

			flowcontainer = {
				direction = vertical
				spacing = 5
				size = { 260 102 }

				textbox = {
					text = "[Character.GetFullNameNoFormatting]"
					default_format = "#v"
					using = fontsize_medium
					size = { 260 30 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					text = "[Character.GetPrimaryRoleTitle]"
					using = fontsize_small
					size = { 260 24 }
					align = left|nobaseline
					elide = right
				}
			}

			widget = {
				parentanchor = vcenter
				size = { 118 46 }
				tooltip_enabled = yes
				tooltip = "[GetScriptedGui('tot_appoint_selected_province_governor').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"

				button_standard = {
					visible = "[GetScriptedGui('tot_appoint_selected_province_governor').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					text = "TOT_PROVINCE_GOVERNOR_APPOINT"
					size = { 118 46 }
					onclick = "[GetScriptedGui('tot_appoint_selected_province_governor').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
					onclick = "[GetScriptedGui('tot_refresh_character_growth').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_appoint_selected_province_governor').ExecuteTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}

				button_standard = {
					visible = "[Not(GetScriptedGui('tot_appoint_selected_province_governor').IsValid(GuiScope.SetRoot(Character.MakeScope).End))]"
					text = "TOT_PROVINCE_GOVERNOR_APPOINT"
					size = { 118 46 }
					tooltip_enabled = yes
					tooltip = "[GetScriptedGui('tot_appoint_selected_province_governor').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}
			}
		}
	}

	# Compact province row for the executive tab's left-hand appointment list.
	type tot_character_executive_governor_state = widget {
		size = { 320 112 }
		datacontext = "[Scope.GetState]"
		visible = "[Scope.GetState.IsValid]"
		background = { using = entry_bg_fancy }

		flowcontainer = {
			margin = { 10 8 }
			spacing = 8
			widget = {
				size = { 60 92 }
				character_portrait_small2 = {
					visible = "[GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End)]"
					datacontext = "[State.MakeScope.Var('tot_province_governor').GetCharacter]"
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
				}
				icon = {
					visible = "[Not(GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End))]"
					texture = "gfx/interface/icons/generic_icons/red_cross.dds"
					size = { 36 36 }
					parentanchor = center
				}
			}
			flowcontainer = {
				direction = vertical
				spacing = 2
				size = { 144 92 }
				textbox = { text = "[State.GetNameNoFormatting]" default_format = "#v" using = fontsize_small size = { 144 22 } align = left|nobaseline elide = right }
				textbox = { visible = "[GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End)]" datacontext = "[State.MakeScope.Var('tot_province_governor').GetCharacter]" text = "[Character.GetFullNameNoFormatting]" using = fontsize_very_small size = { 144 18 } align = left|nobaseline elide = right }
				textbox = { visible = "[Not(GetScriptedGui('tot_remove_province_governor').IsShown(GuiScope.SetRoot(State.MakeScope).End))]" text = "TOT_PROVINCE_GOVERNOR_EMPTY" using = fontsize_very_small size = { 144 18 } align = left|nobaseline elide = right }
				textbox = { text = "TOT_PROVINCE_GOVERNOR_EFFECTS" using = fontsize_very_small size = { 144 34 } align = left|nobaseline multiline = yes }
			}
			button_standard = {
				parentanchor = vcenter
				size = { 70 34 }
				text = "TOT_CHARACTER_GROWTH_SELECT_STATE"
				onclick = "[GetScriptedGui('tot_character_growth_select_governor_state').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
				tooltip = "TOT_CHARACTER_GROWTH_SELECT_STATE_TOOLTIP"
			}
		}
	}

	type tot_character_governor_management = widget {
		size = { 1124 588 }

		vbox = {
			spacing = 6
			textbox = { size = { 1124 26 } text = "TOT_CHARACTER_EXECUTIVE_CANDIDATES" using = fontsize_large align = left|nobaseline }
			textbox = { visible = "[Not(GetScriptedGui('tot_character_growth_has_selected_governor_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 1124 554 } text = "TOT_CHARACTER_GROWTH_SELECT_STATE_FIRST" using = fontsize_medium align = center|nobaseline }
			widget = {
				visible = "[GetScriptedGui('tot_character_growth_has_selected_governor_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 1124 38 }
				hbox = {
					spacing = 6
					textbox = { size = { 132 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE" using = fontsize_small align = left|vcenter|nobaseline }
					button = { visible = "[GetScriptedGui('tot_selected_governor_type_administration').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_ADMINISTRATION" onclick = "[GetScriptedGui('tot_set_selected_governor_type_administration').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_ADMINISTRATION_TOOLTIP" }
					button = { visible = "[Not(GetScriptedGui('tot_selected_governor_type_administration').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_ADMINISTRATION" onclick = "[GetScriptedGui('tot_set_selected_governor_type_administration').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_ADMINISTRATION_TOOLTIP" }
					button = { visible = "[GetScriptedGui('tot_selected_governor_type_finance').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_FINANCE" onclick = "[GetScriptedGui('tot_set_selected_governor_type_finance').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_FINANCE_TOOLTIP" }
					button = { visible = "[Not(GetScriptedGui('tot_selected_governor_type_finance').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_FINANCE" onclick = "[GetScriptedGui('tot_set_selected_governor_type_finance').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_FINANCE_TOOLTIP" }
					button = { visible = "[GetScriptedGui('tot_selected_governor_type_industry').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_INDUSTRY" onclick = "[GetScriptedGui('tot_set_selected_governor_type_industry').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_INDUSTRY_TOOLTIP" }
					button = { visible = "[Not(GetScriptedGui('tot_selected_governor_type_industry').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_INDUSTRY" onclick = "[GetScriptedGui('tot_set_selected_governor_type_industry').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_INDUSTRY_TOOLTIP" }
					button = { visible = "[GetScriptedGui('tot_selected_governor_type_education').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_EDUCATION" onclick = "[GetScriptedGui('tot_set_selected_governor_type_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_EDUCATION_TOOLTIP" }
					button = { visible = "[Not(GetScriptedGui('tot_selected_governor_type_education').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_EDUCATION" onclick = "[GetScriptedGui('tot_set_selected_governor_type_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_EDUCATION_TOOLTIP" }
					button = { visible = "[GetScriptedGui('tot_selected_governor_type_military').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_MILITARY" onclick = "[GetScriptedGui('tot_set_selected_governor_type_military').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_MILITARY_TOOLTIP" }
					button = { visible = "[Not(GetScriptedGui('tot_selected_governor_type_military').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 186 32 } text = "TOT_PROVINCE_GOVERNOR_TYPE_MILITARY" onclick = "[GetScriptedGui('tot_set_selected_governor_type_military').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_PROVINCE_GOVERNOR_TYPE_MILITARY_TOOLTIP" }
				}
			}
			widget = {
				visible = "[GetScriptedGui('tot_character_growth_has_selected_governor_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 1124 38 }
				building_browser_filter_line = {
					parentanchor = hcenter
					blockoverride "line_background" {}
					blockoverride "line_size" { size = { 1098 38 } }
					blockoverride "filter_line_label" { text = "TOT_CHARACTER_FILTER_DUTY" }
					blockoverride "filter_line_buttons" {
						building_browser_filter_line_button = {
							text = "ALL"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_duty_filter_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_duty_filter_all_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
						building_browser_filter_line_button = {
							text = "TOT_CHARACTER_FILTER_SPECIAL_DUTY"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_duty_filter_special').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_duty_filter_special_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
						building_browser_filter_line_button = {
							text = "TOT_CHARACTER_FILTER_NO_DUTY"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_duty_filter_none').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_duty_filter_none_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
					}
				}
			}
			widget = {
				visible = "[GetScriptedGui('tot_character_growth_has_selected_governor_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 1124 38 }
				building_browser_filter_line = {
					parentanchor = hcenter
					blockoverride "line_background" {}
					blockoverride "line_size" { size = { 1098 38 } }
					blockoverride "filter_line_label" { text = "FILTER_HISTORICAL" }
					blockoverride "filter_line_buttons" {
						building_browser_filter_line_button = {
							text = "ALL"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_filter_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_filter_all_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
						building_browser_filter_line_button = {
							text = "HISTORICAL_FILTER_NAME"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_filter_historical').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_filter_historical_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
						building_browser_filter_line_button = {
							text = "NON_HISTORICAL_FILTER_NAME"
							align = hcenter
							blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_governor_candidate_filter_non_historical').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							blockoverride "line_button_icon_texture" { visible = no }
							blockoverride "line_button_selected" { visible = "[GetScriptedGui('tot_governor_candidate_filter_non_historical_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
					}
				}
			}
			scrollbox = {
				visible = "[GetScriptedGui('tot_character_growth_has_selected_governor_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 1124 422 }
				blockoverride "scrollbox_content" {
					fixedgridbox = {
						datamodel = "[GetPlayer.MakeScope.GetList('tot_province_governor_candidates')]"
						addcolumn = 1124
						addrow = 132
						item = {
							tot_character_candidate_item = {
								blockoverride "candidate_action_block" {
									button_standard = {
										size = { 120 32 }
										text = "TOT_PROVINCE_GOVERNOR_APPOINT"
										enabled = "[GetScriptedGui('tot_appoint_selected_province_governor').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
										onclick = "[GetScriptedGui('tot_appoint_selected_province_governor').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
										onclick = "[GetScriptedGui('tot_refresh_character_growth').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										tooltip = "[GetScriptedGui('tot_appoint_selected_province_governor').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
									}
								}
								blockoverride "appoint_hint" { text = "TOT_CHARACTER_GOVERNOR_APPOINT_HINT" }
							}
						}
					}
				}
			}
		}
	}

	type tot_character_growth_progress_character = widget {
		size = { 520 154 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"

		background = {
			using = entry_bg_fancy
		}

		widget = {
			size = { 496 130 }

			flowcontainer = {
				margin = { 12 12 }
				spacing = 10

			widget = {
				size = { 72 124 }
				character_portrait_medium = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
				}
			}

			widget = {
				size = { 78 124 }
				tooltip = "TOT_CHARACTER_GROWTH_EXP_TOOLTIP"

				background = {
					using = entry_bg_simple
				}

				textbox = {
					text = "TOT_CHARACTER_GROWTH_EXP_LABEL"
					using = fontsize_small
					size = { 70 20 }
					parentanchor = top|hcenter
					align = center|nobaseline
				}

				textbox = {
					text = "[Character.MakeScope.Var('tot_character_growth_exp').GetValue|0]"
					using = fontsize_small
					size = { 70 24 }
					parentanchor = center
					align = center|nobaseline
				}

				default_progressbar_horizontal = {
					size = { 62 12 }
					parentanchor = bottom|hcenter
					position = { 0 -16 }
					blockoverride "values" {
						value = "[Character.MakeScope.ScriptValue('tot_character_growth_exp_progress_value')]"
						min = 0
						max = 1
					}
				}
			}

			flowcontainer = {
				direction = vertical
				spacing = 4
				size = { 310 126 }

				textbox = {
					text = "[Character.GetFullNameNoFormatting]"
					default_format = "#v"
					using = fontsize_medium
					size = { 310 27 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					text = "[Character.GetPrimaryRoleTitle]"
					using = fontsize_small
					size = { 310 19 }
					align = left|nobaseline
					elide = right
				}

				textbox = {
					text = "TOT_CHARACTER_GROWTH_LEVEL_AND_POINTS"
					using = fontsize_small
					size = { 310 19 }
					align = left|nobaseline
				}

				textbox = {
					text = "TOT_CHARACTER_GROWTH_EXP_PROGRESS"
					using = fontsize_small
					size = { 310 19 }
					align = left|nobaseline
					elide = right
					tooltip = "TOT_CHARACTER_GROWTH_EXP_TOOLTIP"
				}

				textbox = {
					text = "TOT_CHARACTER_GROWTH_CURRENT_REQUIREMENT"
					using = fontsize_small
					size = { 310 19 }
					align = left|nobaseline
					elide = right
					tooltip = "TOT_CHARACTER_GROWTH_EXP_TOOLTIP"
				}
			}

			}

			button = {
				size = { 496 130 }
				parentanchor = center
				alwaystransparent = yes
				enabled = "[GetScriptedGui('tot_character_growth_select_progress_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
				onclick = "[GetScriptedGui('tot_character_growth_select_progress_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
				onclick = "[GetScriptedGui('tot_refresh_character_growth').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

