flowcontainer = {
	name = "widget_je_tot_band_management"
	ignoreinvisible = yes
	direction = vertical
	spacing = 8

	state = {
		name = refresh_band_lists
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	default_header_clean = {
		size = { 520 84 }
		blockoverride "text" {
			text = "TOT_BAND_PANEL_SUMMARY"
			using = fontsize_large
			default_format = "#medium"
		}
		tooltip = "band_kizuna_tooltip"
	}


	scrollbox = {
		size = { 540 700 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 4

				flowcontainer = {
					visible = "[GetScriptedGui('tot_band_1_unlocked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					direction = vertical
					spacing = 4
					section_header_button = {
						blockoverride "layout" { size = { 520 36 } }
						blockoverride "left_text" { text = "TOT_BAND_1_HEADER" }
						blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('tot_band_1_toggle')]" }
						blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('tot_band_1_toggle'))]" }
						blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('tot_band_1_toggle')]" }
					}
					flowcontainer = {
						visible = "[GetVariableSystem.Exists('tot_band_1_toggle')]"
						direction = vertical
						spacing = 4
						default_header_clean = { size = { 500 76 } blockoverride "text" { text = "TOT_BAND_1_NAME_LABEL" using = fontsize_large default_format = "#medium" } tooltip = "TOT_BAND_NAME_TOOLTIP" }
						button_standard = { size = { 500 34 } text = "TOT_BAND_CHOOSE_NAME" onclick = "[GetScriptedGui('tot_band_1_choose_name').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						flowcontainer = {
							direction = vertical
							spacing = 4
							textbox = { size = { 500 24 } text = "TOT_BAND_CREATION_PROGRESS_LABEL" using = fontsize_medium align = center|nobaseline tooltip = "band_1_kizuna_creation_progress_tooltip" }
							button = { size = { 500 42 } default_progressbar_horizontal = { size = { 500 42 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_bar_value')]" } textbox = { parentanchor = center size = { 360 34 } fontsize = 14 align = center|nobaseline text = "" } } }
							flowcontainer = { spacing = 4 parentanchor = hcenter
								textbox = { text = "TOT_BAND_TIER_1_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_1_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_2_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_2_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_3_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_3_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_4_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_4_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_5_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_5_TOOLTIP" }
							}
							textbox = { size = { 500 38 } text = "TOT_BAND_1_INVESTMENT_SUMMARY" using = fontsize_small align = left|nobaseline multiline = yes tooltip = "band_1_kizuna_creation_progress_tooltip" }
							flowcontainer = { spacing = 4
								button = { using = default_button size = { 78 50 } onclick = "[GetScriptedGui('band_1_gold_effect_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "band_gold_tooltip_1" text = "" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/generic_icons/coin_icon_01.dds" } }
								button = { using = default_button size = { 78 50 } onclick = "[GetScriptedGui('band_1_gold_effect_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "band_gold_tooltip_2" text = "" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/generic_icons/coin_icon_03.dds" } }
								button = { using = default_button size = { 78 50 } onclick = "[GetScriptedGui('band_1_gold_effect_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "band_gold_tooltip_3" text = "" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/generic_icons/coin_icon_05.dds" } }
								button = { using = default_button size = { 78 50 } onclick = "[GetScriptedGui('band_1_gold_effect_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "band_gold_tooltip_4" text = "" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/generic_icons/coin_icon_07.dds" } }
