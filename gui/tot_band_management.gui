flowcontainer = {
	name = "widget_je_tot_band_management"
	ignoreinvisible = yes
	direction = vertical
	spacing = 8

	state = {
		name = refresh_band_lists
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	default_header_clean = {
		size = { 520 84 }
		blockoverride "text" {
			text = "TOT_BAND_PANEL_SUMMARY"
			using = fontsize_large
			default_format = "#medium"
		}
		tooltip = "band_kizuna_tooltip"
	}


	scrollbox = {
		size = { 540 700 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 4

				flowcontainer = {
					visible = "[GetScriptedGui('tot_band_1_unlocked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					direction = vertical
					spacing = 4
					section_header_button = {
						blockoverride "layout" { size = { 520 36 } }
						blockoverride "left_text" { text = "TOT_BAND_1_HEADER" }
						blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('tot_band_1_toggle')]" }
						blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('tot_band_1_toggle'))]" }
						blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('tot_band_1_toggle')]" }
					}
					flowcontainer = {
						visible = "[GetVariableSystem.Exists('tot_band_1_toggle')]"
						direction = vertical
						spacing = 4
						textbox = { visible = "[GetScriptedGui('tot_band_1_not_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 42 } text = "TOT_BAND_BUILD_HQ_FIRST_HINT" using = fontsize_small align = left|nobaseline multiline = yes }
						default_header_clean = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 76 } blockoverride "text" { text = "TOT_BAND_1_NAME_LABEL" using = fontsize_large default_format = "#medium" } tooltip = "TOT_BAND_NAME_TOOLTIP" }
						flowcontainer = {
							visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							direction = vertical
							spacing = 4
							textbox = { size = { 500 24 } text = "TOT_BAND_CREATION_PROGRESS_LABEL" using = fontsize_medium align = center|nobaseline tooltip = "band_1_kizuna_creative_progress_tooltip" }
							default_progressbar_horizontal = {
								size = { 500 24 }
								tooltip = "band_1_kizuna_creative_progress_tooltip"
								blockoverride "values" {
									value = "[AccessPlayer.MakeScope.Var('tot_band_1_creative_progress').GetValue]"
									min = 0
									max = 1000
								}
							}
							textbox = { size = { 500 22 } text = "TOT_BAND_1_CREATIVE_PROGRESS_TEXT" using = fontsize_small align = center|nobaseline tooltip = "band_1_kizuna_creative_progress_tooltip" }
							textbox = { size = { 500 22 } text = "TOT_BAND_LEVEL_LABEL" using = fontsize_small align = center|nobaseline }
							flowcontainer = { size = { 500 44 } spacing = 2
								button = { size = { 49 44 } default_progressbar_horizontal = { size = { 49 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_1_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 49 34 } fontsize = 9 align = center|nobaseline text = "" } } }
								button = { size = { 70 44 } default_progressbar_horizontal = { size = { 70 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_2_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 70 34 } fontsize = 9 align = center|nobaseline text = "" } } }
								button = { size = { 77 44 } default_progressbar_horizontal = { size = { 77 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_3_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 77 34 } fontsize = 10 align = center|nobaseline text = "" } } }
								button = { size = { 111 44 } default_progressbar_horizontal = { size = { 111 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_4_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 111 34 } fontsize = 10 align = center|nobaseline text = "" } } }
								button = { size = { 185 44 } default_progressbar_horizontal = { size = { 185 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_5_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 185 34 } fontsize = 10 align = center|nobaseline text = "" } } }
							}
							flowcontainer = { spacing = 4 parentanchor = hcenter
								textbox = { text = "TOT_BAND_TIER_1_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_1_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_2_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_2_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_3_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_3_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_4_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_4_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_5_STATUS" size = { 94 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_5_TOOLTIP" }
							}
							textbox = { size = { 500 38 } text = "TOT_BAND_BUILDING_INVESTMENT_HINT" using = fontsize_small align = left|nobaseline multiline = yes }
						}
						textbox = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 20 } text = "TOT_BAND_HQ_LINKS_LABEL" using = fontsize_small align = left|nobaseline }
						fixedgridbox = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" datamodel = "[AccessPlayer.MakeScope.GetList('tot_band_1_hq_buildings')]" addcolumn = 500 addrow = 34 item = { tot_band_hq_jump_widget = {} } }
						button_standard = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 34 } text = "TOT_BAND_CHOOSE_NAME" onclick = "[GetScriptedGui('tot_band_1_choose_name').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						textbox = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" raw_text = "当前筛选：[AccessPlayer.GetCustom('tot_band_1_candidate_filter_loc')]" size = { 500 22 } using = fontsize_small align = left|nobaseline }
						flowcontainer = {
							visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							spacing = 4
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_ALL" onclick = "[GetScriptedGui('tot_band_1_filter_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_ANY_SPECIALTY" onclick = "[GetScriptedGui('tot_band_1_filter_any_specialty').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_VOCAL" onclick = "[GetScriptedGui('tot_band_1_filter_vocal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_GUITAR" onclick = "[GetScriptedGui('tot_band_1_filter_guitar').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_BASS" onclick = "[GetScriptedGui('tot_band_1_filter_bass').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
