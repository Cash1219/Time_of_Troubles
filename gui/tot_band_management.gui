							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_DRUM" onclick = "[GetScriptedGui('tot_band_1_filter_drum').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
							button_standard = { size = { 96 28 } text = "TOT_BAND_FILTER_HISTORICAL" onclick = "[GetScriptedGui('tot_band_1_filter_historical').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						}
						textbox = { visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 22 } text = "TOT_BAND_ROLE_PICKER_LABEL" using = fontsize_small align = left|nobaseline }
						flowcontainer = {
							visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
