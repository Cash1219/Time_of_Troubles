types tot_band_page_types
{
	 type tot_band_page = widget {
	 size = { 1480 680 }
	ignoreinvisible = yes

	state = {
		name = refresh_band_lists
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
	state = {
		name = refresh_band_shop
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
	state = {
		name = init_band_management_tab
		trigger_on_create = yes
		# Build story bands and headquarters before this page binds its roster lists.
		on_finish = "[GetScriptedGui('tot_band_initialize_management_page').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_finish = "[GetVariableSystem.Set( 'tot_band_page', 'management' )][GetVariableSystem.Set( 'tot_character_activity_tab', 'bands' )]"
	}

	widget = {
		size = { 520 38 }
		tab_buttons = {
			blockoverride "first_button" { text = "TOT_CHARACTER_ACTIVITY_TAB_BANDS" }
			blockoverride "first_button_selected" { text = "TOT_CHARACTER_ACTIVITY_TAB_BANDS" }
			blockoverride "first_button_tooltip" { tooltip = "TOT_CHARACTER_ACTIVITY_TAB_BANDS" }
			blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_activity_tab', 'bands' )]" }
			blockoverride "first_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_activity_tab', 'bands' )]" }
			blockoverride "first_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_activity_tab', 'bands' ))]" }
			blockoverride "second_button" { text = "TOT_CHARACTER_ACTIVITY_TAB_COMPETITIONS" }
			blockoverride "second_button_selected" { text = "TOT_CHARACTER_ACTIVITY_TAB_COMPETITIONS" }
			blockoverride "second_button_tooltip" { tooltip = "TOT_CHARACTER_ACTIVITY_TAB_COMPETITIONS" }
			blockoverride "second_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_activity_tab', 'competitions' )]" }
			blockoverride "second_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_activity_tab', 'competitions' )]" }
			blockoverride "second_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_activity_tab', 'competitions' ))]" }
			blockoverride "third_button" { text = "TOT_CHARACTER_ACTIVITY_TAB_DEBT" }
			blockoverride "third_button_selected" { text = "TOT_CHARACTER_ACTIVITY_TAB_DEBT" }
			blockoverride "third_button_tooltip" { tooltip = "TOT_CHARACTER_ACTIVITY_TAB_DEBT" }
			blockoverride "third_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_activity_tab', 'debt' )]" }
			blockoverride "third_button_visibility" { visible = "[And(GetScriptedGui('tot_avmj_debt_activity_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_character_activity_tab', 'debt' ))]" }
			blockoverride "third_button_visibility_checked" { visible = "[And(GetScriptedGui('tot_avmj_debt_activity_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_character_activity_tab', 'debt' )))]" }
			blockoverride "fourth_button_visibility" { visible = no }
			blockoverride "fourth_button_visibility_checked" { visible = no }
			blockoverride "fifth_button_visibility" { visible = no }
			blockoverride "fifth_button_visibility_checked" { visible = no }
		}
	}

	widget = {
		size = { 1480 640 }
		position = { 0 40 }
		visible = "[GetVariableSystem.HasValue( 'tot_character_activity_tab', 'bands' )]"
		flowcontainer = {
			# Keep the active band, roster and filters as the top, central work area.
			direction = vertical
			spacing = 8
	widget = {
		size = { 520 38 }
		tab_buttons = {
			blockoverride "first_button" { text = "TOT_BAND_TAB_MANAGEMENT" }
			blockoverride "first_button_selected" { text = "TOT_BAND_TAB_MANAGEMENT" }
			blockoverride "first_button_tooltip" { tooltip = "TOT_BAND_TAB_MANAGEMENT" }
				blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set( 'tot_band_page', 'management' )]" }
			blockoverride "first_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_band_page', 'management' )]" }
			blockoverride "first_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_band_page', 'management' ))]" }
			blockoverride "second_button" { text = "TOT_BAND_TAB_SHOP" }
			blockoverride "second_button_selected" { text = "TOT_BAND_TAB_SHOP" }
			blockoverride "second_button_tooltip" { tooltip = "TOT_BAND_TAB_SHOP" }
				blockoverride "second_button_click" { onclick = "[GetVariableSystem.Set( 'tot_band_page', 'shop' )]" }
			blockoverride "second_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_band_page', 'shop' )]" }
			blockoverride "second_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_band_page', 'shop' ))]" }
			blockoverride "third_button_visibility" { visible = no }
			blockoverride "third_button_visibility_checked" { visible = no }
			blockoverride "fourth_button_visibility" { visible = no }
			blockoverride "fourth_button_visibility_checked" { visible = no }
			blockoverride "fifth_button_visibility" { visible = no }
			blockoverride "fifth_button_visibility_checked" { visible = no }
		}
	}
	}


	# Select a band independently from the roster editor below.
	scrollbox = {
		position = { 0 120 }
		visible = "[Or(GetVariableSystem.HasValue( 'tot_band_page', 'management' ), Not(GetVariableSystem.HasValue( 'tot_band_page', 'shop' )))]"
		size = { 520 165 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 3
				textbox = { visible = "[GetScriptedGui('tot_band_no_headquarters').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 42 } text = "TOT_BAND_BUILD_HQ_FIRST_HINT" using = fontsize_small align = left|nobaseline multiline = yes }
				button = { visible = "[And(GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '1' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_1_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '1' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '1' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_1_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '1' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_2_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '2' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_2_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '2' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_2_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '2' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_2_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '2' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_3_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '3' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_3_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '3' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_3_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '3' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_3_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '3' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_4_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '4' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_4_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '4' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_4_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '4' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_4_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '4' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_5_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '5' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_5_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '5' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_5_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '5' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_5_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '5' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_6_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '6' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_6_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '6' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_6_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '6' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_6_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '6' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_7_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '7' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_7_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '7' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_7_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '7' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_7_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '7' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_8_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '8' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_8_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '8' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_8_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '8' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_8_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '8' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_9_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '9' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_9_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '9' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_9_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '9' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_9_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '9' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_10_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue( 'tot_band_selected', '10' ))]" using = default_button_primary size = { 500 27 } text = "TOT_BAND_10_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '10' )]" }
				button = { visible = "[And(GetScriptedGui('tot_band_10_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetVariableSystem.HasValue( 'tot_band_selected', '10' )))]" using = default_button size = { 500 27 } text = "TOT_BAND_10_HEADER" onclick = "[GetVariableSystem.Set( 'tot_band_selected', '10' )]" }
			}
		}
	}

	scrollbox = {
		position = { 0 295 }
		visible = "[Or(GetVariableSystem.HasValue( 'tot_band_page', 'management' ), Not(GetVariableSystem.HasValue( 'tot_band_page', 'shop' )))]"
		size = { 520 345 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 4

				flowcontainer = {
					visible = "[GetScriptedGui('tot_band_1_unlocked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					direction = vertical
					spacing = 4
					section_header_button = {
						visible = no
						blockoverride "layout" { size = { 520 36 } }
						blockoverride "left_text" { text = "TOT_BAND_1_HEADER" }
						blockoverride "onclick" { onclick = "[GetVariableSystem.Set( 'tot_band_selected', '1' )]" }
						blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.HasValue( 'tot_band_selected', '1' ))]" }
						blockoverride "onclick_showless" { visible = "[GetVariableSystem.HasValue( 'tot_band_selected', '1' )]" }
					}
					flowcontainer = {
						visible = "[GetVariableSystem.HasValue( 'tot_band_selected', '1' )]"
						direction = vertical
						spacing = 4
						textbox = { visible = "[GetScriptedGui('tot_band_1_not_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 500 42 } text = "TOT_BAND_BUILD_HQ_FIRST_HINT" using = fontsize_small align = left|nobaseline multiline = yes }
						flowcontainer = {
							visible = no
							direction = vertical
							spacing = 4
							textbox = { size = { 500 24 } text = "TOT_BAND_CREATION_PROGRESS_LABEL" using = fontsize_medium align = center|nobaseline tooltip = "band_1_kizuna_creative_progress_tooltip" }
							default_progressbar_horizontal = {
								size = { 500 24 }
								tooltip = "band_1_kizuna_creative_progress_tooltip"
								blockoverride "values" {
									value = "[AccessPlayer.MakeScope.Var('tot_band_1_creative_progress').GetValue]"
									min = 0
									max = 1000
								}
							}
							textbox = { size = { 500 22 } text = "TOT_BAND_1_CREATIVE_PROGRESS_TEXT" using = fontsize_small align = center|nobaseline tooltip = "band_1_kizuna_creative_progress_tooltip" }
							textbox = { visible = no size = { 500 22 } text = "TOT_BAND_1_PROGRESS_LEVEL_TEXT" using = fontsize_small align = center|nobaseline tooltip = "band_1_kizuna_creation_progress_tooltip" }
							textbox = { visible = no size = { 500 22 } text = "TOT_BAND_LEVEL_LABEL" using = fontsize_small align = center|nobaseline }
							widget = { size = { 500 44 }
							flowcontainer = { visible = no spacing = 2
								button = { size = { 16 44 } default_progressbar_horizontal = { size = { 16 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_1_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 16 34 } fontsize = 9 align = center|nobaseline text = "" } } }
								button = { size = { 33 44 } default_progressbar_horizontal = { size = { 33 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_2_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 33 34 } fontsize = 9 align = center|nobaseline text = "" } } }
								button = { size = { 66 44 } default_progressbar_horizontal = { size = { 66 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_3_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 66 34 } fontsize = 10 align = center|nobaseline text = "" } } }
								button = { size = { 131 44 } default_progressbar_horizontal = { size = { 131 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_4_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 131 34 } fontsize = 10 align = center|nobaseline text = "" } } }
								button = { size = { 246 44 } default_progressbar_horizontal = { size = { 246 44 } tooltip = "band_1_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_1_kizuna_creation_progress_segment_5_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 246 34 } fontsize = 10 align = center|nobaseline text = "" } } }
								}
							}
							widget = { size = { 500 24 }
								textbox = { text = "TOT_BAND_TIER_1_STATUS" position = { 0 0 } size = { 32 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_1_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_2_STATUS" position = { 33 0 } size = { 32 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_2_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_3_STATUS" position = { 98 0 } size = { 34 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_3_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_4_STATUS" position = { 226 0 } size = { 40 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_4_TOOLTIP" }
								textbox = { text = "TOT_BAND_TIER_5_STATUS" parentanchor = top|right position = { 0 0 } size = { 40 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_5_TOOLTIP" }
							}
							textbox = { size = { 500 56 } text = "TOT_BAND_1_INVESTMENT_SUMMARY" using = fontsize_small align = left|nobaseline multiline = yes tooltip = "band_1_kizuna_creation_progress_tooltip" }
						}
						fixedgridbox = { datamodel = "[AccessPlayer.MakeScope.GetList('tot_band_1_hq_buildings')]" addcolumn = 500 addrow = 34 item = { tot_band_hq_jump_widget = {} } }
						button_standard = { visible = no size = { 500 34 } text = "TOT_BAND_CHOOSE_NAME" onclick = "[GetScriptedGui('tot_band_1_choose_name').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						flowcontainer = {
							visible = "[GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							direction = vertical
							spacing = 5
							textbox = { size = { 500 24 } text = "TOT_BAND_ROLE_TABS_HEADER" using = fontsize_small align = left|nobaseline }
							flowcontainer = {
								spacing = 3
								button = { visible = "[GetScriptedGui('tot_band_1_role_vocalist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 80 30 } text = "TOT_BAND_ROLE_VOCAL_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_vocal.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_vocalist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[Not(GetScriptedGui('tot_band_1_role_vocalist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 80 30 } text = "TOT_BAND_ROLE_VOCAL_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_vocal.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_vocalist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[GetScriptedGui('tot_band_1_role_guitarist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 80 30 } text = "TOT_BAND_ROLE_GUITAR_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_guitar_center.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_guitarist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[Not(GetScriptedGui('tot_band_1_role_guitarist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 80 30 } text = "TOT_BAND_ROLE_GUITAR_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_guitar_center.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_guitarist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[GetScriptedGui('tot_band_1_role_bassist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 80 30 } text = "TOT_BAND_ROLE_BASS_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_bass.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_bassist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[Not(GetScriptedGui('tot_band_1_role_bassist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 80 30 } text = "TOT_BAND_ROLE_BASS_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_bass.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_bassist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button = { visible = "[GetScriptedGui('tot_band_1_role_keyboardist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 80 30 } text = "TOT_BAND_ROLE_KEYBOARD_TEXT" icon = { parentanchor = left|vcenter position = { 6 0 } size = { 16 16 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_keyboard.dds" } onclick = "[GetScriptedGui('tot_band_1_select_role_keyboardist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
