								widget = { size = { 78 50 }
									button = { visible = "[GetScriptedGui('tot_band_1_invest_musical_instrument_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 78 50 } onclick = "[GetScriptedGui('tot_band_1_invest_musical_instrument').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "band_tools_tooltip" text = "" icon = { parentanchor = center size = { 28 28 } texture = "gfx/interface/icons/goods_icons/musical_instrument.dds" } }
									button = { visible = "[Not(GetScriptedGui('tot_band_1_invest_musical_instrument_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 78 50 } enabled = "[GetScriptedGui('tot_band_1_invest_musical_instrument').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_band_1_invest_musical_instrument').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[SelectLocalization(GetScriptedGui('tot_band_1_invest_musical_instrument').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'band_tools_tooltip', 'band_tools_invalid_tooltip')]" text = "" icon = { parentanchor = center size = { 28 28 } texture = "gfx/interface/icons/goods_icons/musical_instrument.dds" } }
