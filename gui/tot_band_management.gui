							fixedgridbox = { datamodel = "[AccessPlayer.MakeScope.GetList('tot_band_1_vocalists')]" addcolumn = 92 addrow = 56 item = { tot_band_role_slot_portrait = {} } }
							fixedgridbox = { datamodel = "[AccessPlayer.MakeScope.GetList('tot_band_1_guitarists')]" addcolumn = 92 addrow = 56 item = { tot_band_role_slot_portrait = {} } }
