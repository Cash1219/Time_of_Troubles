						button = { visible = "[And(GetScriptedGui('tot_band_1_created').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('tot_band_1_role_vocalist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" using = default_button size = { 500 38 } onclick = "[GetScriptedGui('tot_band_1_select_role_vocalist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text = "TOT_BAND_SLOT_VOCAL" }
