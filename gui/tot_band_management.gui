							button = { size = { 66 44 } default_progressbar_horizontal = { size = { 66 44 } tooltip = "band_10_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_10_kizuna_creation_progress_segment_3_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 66 34 } fontsize = 10 align = center|nobaseline text = "" } } }
							button = { size = { 131 44 } default_progressbar_horizontal = { size = { 131 44 } tooltip = "band_10_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_10_kizuna_creation_progress_segment_4_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 131 34 } fontsize = 10 align = center|nobaseline text = "" } } }
							button = { size = { 246 44 } default_progressbar_horizontal = { size = { 246 44 } tooltip = "band_10_kizuna_creation_progress_tooltip" blockoverride "values" { value = "[AccessPlayer.MakeScope.ScriptValue('band_10_kizuna_creation_progress_segment_5_value')]" min = 0 max = 1 } textbox = { parentanchor = center size = { 246 34 } fontsize = 10 align = center|nobaseline text = "" } } }
						}
						widget = { size = { 500 24 }
							textbox = { text = "TOT_BAND_TIER_1_STATUS" position = { 0 0 } size = { 32 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_1_TOOLTIP" }
							textbox = { text = "TOT_BAND_TIER_2_STATUS" position = { 33 0 } size = { 32 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_2_TOOLTIP" }
							textbox = { text = "TOT_BAND_TIER_3_STATUS" position = { 98 0 } size = { 34 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_3_TOOLTIP" }
							textbox = { text = "TOT_BAND_TIER_4_STATUS" position = { 226 0 } size = { 40 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_4_TOOLTIP" }
							textbox = { text = "TOT_BAND_TIER_5_STATUS" parentanchor = top|right position = { 0 0 } size = { 40 24 } using = fontsize_small align = center|nobaseline tooltip = "TOT_BAND_TIER_5_TOOLTIP" }
						}
						textbox = { size = { 500 56 } text = "TOT_BAND_10_INVESTMENT_SUMMARY" using = fontsize_small align = left|nobaseline multiline = yes tooltip = "band_10_kizuna_creation_progress_tooltip" }
						textbox = { text = "TOT_BAND_CANDIDATES_LABEL" size = { 500 28 } using = fontsize_medium align = left|nobaseline }
						scrollbox = { size = { 480 384 } blockoverride "scrollbox_content" { fixedgridbox = { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('tot_band_10_candidates')]" addcolumn = 480 addrow = 170 item = { tot_band_10_candidate_character = {} } } } }
					}
				}
			}

		}
	}

	scrollbox = {
		visible = "[GetVariableSystem.HasValue( 'tot_band_page', 'shop' )]"
		size = { 540 860 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 6
				default_header_clean = {
					size = { 500 76 }
					blockoverride "text" { text = "TOT_BAND_SHOP_HEADER" using = fontsize_large default_format = "#medium" }
				}
				textbox = {
					size = { 500 46 }
					text = "TOT_BAND_SHOP_DESC"
					using = fontsize_small
					align = left|nobaseline
					multiline = yes
				}
				textbox = {
					size = { 500 24 }
					raw_text = "当前点数池：[AccessPlayer.MakeScope.Var('tot_band_reward_points_total').GetValue|0]"
					using = fontsize_small
					align = left|nobaseline
				}
				button_standard = {
					size = { 500 52 }
					text = "TOT_BAND_SHOP_LAW_BUFF"
					onclick = "[GetScriptedGui('tot_band_shop_buy_law_success_buff').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_shop_buy_law_success_buff').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				textbox = {
					size = { 500 34 }
					text = "TOT_BAND_SHOP_LAW_BUFF_DESC"
					using = fontsize_small
					align = left|nobaseline
					multiline = yes
				}
				button_standard = {
					size = { 500 52 }
					text = "TOT_BAND_SHOP_AUTHORITY_BUFF"
					onclick = "[GetScriptedGui('tot_band_shop_buy_authority_buff').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_shop_buy_authority_buff').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				textbox = {
					size = { 500 34 }
					text = "TOT_BAND_SHOP_AUTHORITY_BUFF_DESC"
					using = fontsize_small
					align = left|nobaseline
					multiline = yes
				}
				button_standard = {
					size = { 500 52 }
					text = "TOT_BAND_SHOP_INFLUENCE_BUFF"
					onclick = "[GetScriptedGui('tot_band_shop_buy_influence_buff').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_shop_buy_influence_buff').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				textbox = {
					size = { 500 34 }
					text = "TOT_BAND_SHOP_INFLUENCE_BUFF_DESC"
					using = fontsize_small
					align = left|nobaseline
					multiline = yes
				}
			}
		}
	}
}
















