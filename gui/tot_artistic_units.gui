types tot_special_units_types
{
	type tot_special_units_page = widget {
		size = { 1400 640 }
		ignoreinvisible = yes

		vbox = {
			spacing = 8
			textbox = {
				size = { 1400 34 }
				text = "TOT_SPECIAL_UNITS_TITLE"
				using = fontsize_large
				align = left|nobaseline
			}

			hbox = {
				size = { 1400 598 }
				spacing = 14
				ignoreinvisible = yes

				# Keep both unit choices in one stable list.
				widget = {
					size = { 300 598 }
					background = { using = entry_bg_fancy }
					vbox = {
						margin = { 14 14 }
						spacing = 8
						textbox = {
							size = { 272 30 }
							text = "TOT_SPECIAL_UNITS_AVAILABLE_HEADER"
							using = fontsize_medium
							align = left|nobaseline
						}
						widget = {
							size = { 272 180 }
							background = { using = entry_bg_simple }
							vbox = {
								margin = { 8 8 }
								spacing = 8
								button = {
									visible = "[GetScriptedGui('tot_special_units_guard_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									using = default_button_primary
									size = { 256 52 }
									text = "TOT_SPECIAL_UNITS_GUARD_TITLE"
									onclick = "[GetScriptedGui('tot_special_units_select_guard').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								button = {
									visible = "[GetScriptedGui('tot_special_units_knight_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									using = default_button_primary
									size = { 256 52 }
									text = "TOT_SPECIAL_UNITS_KNIGHT_TITLE"
									onclick = "[GetScriptedGui('tot_special_units_select_knight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = {
									visible = "[Not(GetScriptedGui('tot_special_units_guard_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
									size = { 256 72 }
									text = "TOT_SPECIAL_UNITS_NONE_AVAILABLE"
									using = fontsize_small
									align = center|nobaseline
									multiline = yes
								}
							}
						}
					}
				}

				widget = {
					size = { 1086 598 }
					background = { using = entry_bg_fancy }

					widget = {
						visible = "[GetScriptedGui('tot_special_units_guard_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						size = { 1086 598 }
						vbox = {
							margin = { 22 18 }
							spacing = 12
							textbox = { size = { 1042 34 } text = "TOT_SPECIAL_UNITS_GUARD_TITLE" using = fontsize_large align = left|nobaseline }
							textbox = { size = { 1042 34 } text = "TOT_SPECIAL_UNITS_GUARD_DESC" using = fontsize_small align = left|nobaseline multiline = yes }

							hbox = {
								size = { 1042 112 }
								spacing = 10
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "TOT_SPECIAL_UNITS_TYPE_HEADER" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 32 32 } texture = "gfx/interface/icons/military_icons/organization.dds" } textbox = { size = { 193 40 } text = "TOT_SPECIAL_UNITS_GUARD_TYPE" using = fontsize_medium align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "OFFENSE" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 34 34 } texture = "gfx/interface/icons/military_icons/offense.dds" } textbox = { size = { 191 40 } raw_text = "#v [AccessPlayer.MakeScope.ScriptValue('tot_idol_guard_offense_value')|0]#!" using = fontsize_large align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "DEFENSE" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 34 34 } texture = "gfx/interface/icons/military_icons/defense.dds" } textbox = { size = { 191 40 } raw_text = "#v [AccessPlayer.MakeScope.ScriptValue('tot_idol_guard_defense_value')|0]#!" using = fontsize_large align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "TOT_SPECIAL_UNITS_LIMIT_HEADER" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 32 32 } texture = "gfx/interface/icons/military_icons/manpower.dds" } textbox = { size = { 193 44 } text = "TOT_SPECIAL_UNITS_GUARD_LIMIT_STATUS" using = fontsize_medium multiline = yes align = left|vcenter } }
									}
								}
							}

							textbox = { size = { 1042 26 } text = "TOT_SPECIAL_UNITS_RECRUIT_HEADER" using = fontsize_medium align = left|nobaseline }
							hbox = {
								size = { 1042 52 }
								spacing = 10
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_GUARD_1" enabled = "[GetScriptedGui('tot_special_units_recruit_guard').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_guard').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_guard').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_GUARD_5" enabled = "[GetScriptedGui('tot_special_units_recruit_guard_5').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_guard_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_guard_5').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_GUARD_10" enabled = "[GetScriptedGui('tot_special_units_recruit_guard_10').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_guard_10').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_guard_10').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 220 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_GUARD_MAX" enabled = "[GetScriptedGui('tot_special_units_recruit_guard_max').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_guard_max').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_guard_max').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			textbox = { size = { 1042 88 } text = "TOT_SPECIAL_UNITS_RULES" using = fontsize_small align = left|nobaseline multiline = yes }
		}
		}

					widget = {
						visible = "[GetScriptedGui('tot_special_units_knight_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						size = { 1086 598 }
						vbox = {
							margin = { 22 18 }
							spacing = 12
							textbox = { size = { 1042 34 } text = "TOT_SPECIAL_UNITS_KNIGHT_TITLE" using = fontsize_large align = left|nobaseline }
							textbox = { size = { 1042 34 } text = "TOT_SPECIAL_UNITS_KNIGHT_DESC" using = fontsize_small align = left|nobaseline multiline = yes }

							hbox = {
								size = { 1042 112 }
								spacing = 10
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "TOT_SPECIAL_UNITS_TYPE_HEADER" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 32 32 } texture = "gfx/interface/icons/military_icons/organization.dds" } textbox = { size = { 193 40 } text = "TOT_SPECIAL_UNITS_KNIGHT_TYPE" using = fontsize_medium align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "OFFENSE" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 34 34 } texture = "gfx/interface/icons/military_icons/offense.dds" } textbox = { size = { 191 40 } raw_text = "#v [AccessPlayer.MakeScope.ScriptValue('tot_idol_knight_offense_value')|0]#!" using = fontsize_large align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "DEFENSE" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 34 34 } texture = "gfx/interface/icons/military_icons/defense.dds" } textbox = { size = { 191 40 } raw_text = "#v [AccessPlayer.MakeScope.ScriptValue('tot_idol_knight_defense_value')|0]#!" using = fontsize_large align = left|vcenter } }
									}
								}
								widget = {
									size = { 253 112 }
									background = { using = entry_bg_simple }
									vbox = {
										margin = { 10 8 }
										spacing = 5
										textbox = { size = { 233 22 } text = "TOT_SPECIAL_UNITS_LIMIT_HEADER" using = fontsize_small }
										hbox = { size = { 233 54 } spacing = 8 icon = { size = { 32 32 } texture = "gfx/interface/icons/military_icons/manpower.dds" } textbox = { size = { 193 44 } text = "TOT_SPECIAL_UNITS_KNIGHT_LIMIT_STATUS" using = fontsize_medium multiline = yes align = left|vcenter } }
									}
								}
							}

							textbox = { size = { 1042 26 } text = "TOT_SPECIAL_UNITS_RECRUIT_HEADER" using = fontsize_medium align = left|nobaseline }
							hbox = {
								size = { 1042 52 }
								spacing = 10
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_KNIGHT_1" enabled = "[GetScriptedGui('tot_special_units_recruit_knight').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_knight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_knight').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_KNIGHT_5" enabled = "[GetScriptedGui('tot_special_units_recruit_knight_5').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_knight_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_knight_5').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 190 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_KNIGHT_10" enabled = "[GetScriptedGui('tot_special_units_recruit_knight_10').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_knight_10').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_knight_10').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
								button_standard = { size = { 220 48 } text = "TOT_SPECIAL_UNITS_RECRUIT_KNIGHT_MAX" enabled = "[GetScriptedGui('tot_special_units_recruit_knight_max').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_special_units_recruit_knight_max').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_special_units_recruit_knight_max').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			textbox = { size = { 1042 88 } text = "TOT_SPECIAL_UNITS_RULES" using = fontsize_small align = left|nobaseline multiline = yes }
		}
		}
				}
			}
		}
	}
}
