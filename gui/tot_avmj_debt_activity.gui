						button_standard = { size = { 300 34 } text = "TOT_AVMJ_DEBT_PAY_STANDARD" onclick = "[GetScriptedGui('tot_avmj_debt_pay_standard').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						button_standard = { size = { 300 34 } text = "TOT_AVMJ_DEBT_PAY_HIGH" onclick = "[GetScriptedGui('tot_avmj_debt_pay_high').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
