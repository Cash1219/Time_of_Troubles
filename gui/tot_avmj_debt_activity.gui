types tot_avmj_debt_activity_types
{
	type tot_avmj_debt_creditor_card = widget {
	datacontext = "[Scope.GetCountry]"
	size = { 280 150 }
	using = entry_bg_fancy
	hbox = {
		margin = { 10 8 }
		spacing = 14
		widget = {
			size = { 62 62 }
			character_portrait_medium = {
				datacontext = "[Country.GetRuler]"
				blockoverride "show_hat" {}
				blockoverride "rank_icon" {}
			}
		}
		vbox = {
			size = { 184 122 }
			spacing = 3
			textbox = { size = { 184 22 } text = "[Country.GetName]" using = fontsize_small align = left|nobaseline elide = right }
			widget = { size = { 184 28 } small_flag_no_interact = { parentanchor = left|top } }
			block "card_claim" { textbox = { size = { 184 20 } text = "TOT_AVMJ_DEBT_CREDITOR" using = fontsize_small align = right|nobaseline } }
			block "card_progress" { default_progressbar_horizontal = { size = { 184 20 } blockoverride "values" { min = 0 max = 5 } } }
		}
	}
}

	type tot_avmj_debt_activity_page = widget {
