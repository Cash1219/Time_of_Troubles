				using = entry_bg_fancy
				vbox = {
					margin = { 12 7 }
					spacing = 3
					textbox = { size = { 1450 20 } text = "TOT_AVMJ_DEBT_LEDGER" using = fontsize_medium align = left|nobaseline }
					hbox = {
						spacing = 15
						textbox = { size = { 350 18 } raw_text = "剩余本金：[GetPlayer.MakeScope.Var('tot_avmj_debt_principal').GetValue|0]" using = fontsize_small align = left|nobaseline }
						textbox = { size = { 350 18 } raw_text = "累计利息：[GetPlayer.MakeScope.Var('tot_avmj_interest_due').GetValue|0]" using = fontsize_small align = left|nobaseline }
						textbox = { size = { 350 18 } raw_text = "资金池：[GetPlayer.MakeScope.Var('tot_avmj_debt_fund').GetValue|0]" using = fontsize_small align = left|nobaseline }
						textbox = { size = { 350 18 } raw_text = "自动结算：[GetPlayer.MakeScope.Var('tot_avmj_months_until_assembly').GetValue|0]个月后" using = fontsize_small align = left|nobaseline }
					}
					hbox = {
						spacing = 15
						textbox = { size = { 350 18 } raw_text = "本期本金：[GetPlayer.MakeScope.Var('tot_avmj_last_assembly_principal').GetValue|0]" using = fontsize_small align = left|nobaseline }
						textbox = { size = { 350 18 } raw_text = "本期利息：[GetPlayer.MakeScope.Var('tot_avmj_last_assembly_interest').GetValue|0]" using = fontsize_small align = left|nobaseline }
						textbox = { size = { 350 18 } raw_text = "利息短缺：[GetPlayer.MakeScope.Var('tot_avmj_last_assembly_shortfall').GetValue|0]" using = fontsize_small align = left|nobaseline }
