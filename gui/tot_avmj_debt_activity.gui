						textbox = { size = { 700 20 } text = "TOT_AVMJ_DEBT_EVENT_HISTORY" using = fontsize_medium align = left|nobaseline }
						textbox = { size = { 700 65 } text = "TOT_AVMJ_DEBT_EVENT_NONE" using = fontsize_small multiline = yes visible = "[GetScriptedGui('tot_avmj_debt_rita_event_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						textbox = { size = { 700 65 } text = "TOT_AVMJ_DEBT_EVENT_RITA_RENEWED" using = fontsize_small multiline = yes visible = "[GetScriptedGui('tot_avmj_debt_rita_event_renewed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						textbox = { size = { 700 65 } text = "TOT_AVMJ_DEBT_EVENT_RITA_RETURNED" using = fontsize_small multiline = yes visible = "[GetScriptedGui('tot_avmj_debt_rita_event_returned').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
					}
					vbox = {
						size = { 710 95 }
						textbox = { size = { 700 20 } text = "TOT_AVMJ_DEBT_EVENT_UPCOMING" using = fontsize_medium align = left|nobaseline }
						textbox = { size = { 700 65 } text = "TOT_AVMJ_DEBT_EVENT_RITA_CONTRACT" using = fontsize_small multiline = yes visible = "[GetScriptedGui('tot_avmj_debt_rita_event_pending').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						textbox = { size = { 700 65 } text = "TOT_AVMJ_DEBT_EVENT_RITA_STRUGGLE" using = fontsize_small multiline = yes visible = "[GetScriptedGui('tot_avmj_debt_rita_event_renewed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
					}
				}
