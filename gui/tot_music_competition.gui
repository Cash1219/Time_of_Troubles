						textbox = { visible = "[And(GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" size = { 1030 22 } text = "TOT_MUSIC_COMPETITION_AUTO_FINAL" using = fontsize_small align = center|nobaseline }
					}
				}
			}
		}
	}
}
