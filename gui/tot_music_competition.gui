		hbox = {
			margin = { 6 4 }
			spacing = 7
			widget = { size = { 54 54 } background = { texture = "gfx/interface/icons/character_icons/character_frame.dds" size = { 50 50 } parentanchor = center } character_portrait_small2 = { parentanchor = center blockoverride "show_hat" {} blockoverride "highlight" {} blockoverride "rank_icon" {} } }
			vbox = {
				size = { 170 54 }
				parentanchor = vcenter
				textbox = { size = { 170 18 } raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!" using = fontsize_small align = left|nobaseline elide = right }
				textbox = { size = { 170 14 } raw_text = "[Character.GetPrimaryRoleTitle]" using = fontsize_very_small align = left|nobaseline elide = right }
			}
			button_standard = { parentanchor = vcenter size = { 88 28 } text = "TOT_MUSIC_COMPETITION_SELECT_REPRESENTATIVE" enabled = "[GetScriptedGui('tot_music_competition_select_idol_representative').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]" onclick = "[GetScriptedGui('tot_music_competition_select_idol_representative').Execute(GuiScope.SetRoot(Character.MakeScope).End)]" }
		}
	}

