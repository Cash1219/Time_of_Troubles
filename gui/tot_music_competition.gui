	type tot_music_competition_page = widget {
		size = { 1480 640 }
		ignoreinvisible = yes
		state = {
			name = initialize_music_competition
			trigger_on_create = yes
			on_finish = "[GetScriptedGui('tot_music_competition_initialize').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		vbox = {
			# Keep a small bottom buffer inside the 640px activity sub-page.
			spacing = 7
			textbox = { size = { 1480 30 } text = "TOT_MUSIC_COMPETITION_TITLE" using = fontsize_large align = left|nobaseline }
			textbox = { size = { 1480 34 } text = "TOT_MUSIC_COMPETITION_INTRO" using = fontsize_small align = left|nobaseline multiline = yes }

			hbox = {
				spacing = 8
				button = { visible = "[GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 170 32 } text = "TOT_MUSIC_COMPETITION_BAND" onclick = "[GetScriptedGui('tot_music_competition_select_band').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				button = { visible = "[Not(GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 170 32 } text = "TOT_MUSIC_COMPETITION_BAND" onclick = "[GetScriptedGui('tot_music_competition_select_band').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}

			hbox = {
				spacing = 6
				button = { visible = "[Or(GetVariableSystem.HasValue('tot_music_competition_view', 'qualifying'), Not(GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" using = default_button_primary size = { 150 28 } text = "TOT_MUSIC_COMPETITION_VIEW_QUALIFYING" onclick = "[GetVariableSystem.Set( 'tot_music_competition_view', 'qualifying' )]" }
				button = { visible = "[And(Not(GetVariableSystem.HasValue('tot_music_competition_view', 'qualifying')), GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 150 28 } text = "TOT_MUSIC_COMPETITION_VIEW_QUALIFYING" onclick = "[GetVariableSystem.Set( 'tot_music_competition_view', 'qualifying' )]" }
				button = { visible = "[And(GetVariableSystem.HasValue('tot_music_competition_view', 'final'), GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button_primary size = { 150 28 } text = "TOT_MUSIC_COMPETITION_VIEW_FINAL" onclick = "[GetVariableSystem.Set( 'tot_music_competition_view', 'final' )]" }
				button = { visible = "[And(Not(GetVariableSystem.HasValue('tot_music_competition_view', 'final')), GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" using = default_button size = { 150 28 } text = "TOT_MUSIC_COMPETITION_VIEW_FINAL" onclick = "[GetVariableSystem.Set( 'tot_music_competition_view', 'final' )]" }
			}

			hbox = {
				spacing = 12
				widget = {
						size = { 380 484 }
					using = entry_bg_fancy
					vbox = {
						margin = { 12 12 }
						spacing = 6
						textbox = { size = { 350 24 } text = "TOT_MUSIC_COMPETITION_REGISTRATION" using = fontsize_medium align = left|nobaseline }
						textbox = { size = { 350 60 } text = "TOT_MUSIC_COMPETITION_QUALIFICATION" using = fontsize_small align = left|nobaseline multiline = yes }
						textbox = { visible = "[Not(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 350 44 } text = "TOT_MUSIC_COMPETITION_NOT_REGISTERED" using = fontsize_small align = left|nobaseline multiline = yes }
						textbox = { visible = "[GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 350 44 } text = "TOT_MUSIC_COMPETITION_REGISTERED" using = fontsize_small align = left|nobaseline multiline = yes }
						button_standard = { visible = "[And(Not(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), Not(GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" size = { 350 34 } text = "TOT_MUSIC_COMPETITION_REGISTER" enabled = "[GetScriptedGui('tot_music_competition_register').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_MUSIC_COMPETITION_REGISTER_TOOLTIP" onclick = "[GetScriptedGui('tot_music_competition_register').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						button_standard = { visible = "[And(Not(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 350 34 } text = "TOT_MUSIC_COMPETITION_REGISTER_SELECTED_BAND" enabled = "[GetScriptedGui('tot_music_competition_register').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_MUSIC_COMPETITION_REGISTER_SELECTED_BAND_TOOLTIP" onclick = "[GetScriptedGui('tot_music_competition_register').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						button_standard = { visible = "[And(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 350 34 } text = "TOT_MUSIC_COMPETITION_REGISTER_SELECTED_BAND" enabled = "[GetScriptedGui('tot_music_competition_register_selected_band').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "TOT_MUSIC_COMPETITION_REGISTER_SELECTED_BAND_TOOLTIP" onclick = "[GetScriptedGui('tot_music_competition_register_selected_band').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						button_standard = { visible = "[And(And(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('tot_music_competition_band_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), GetScriptedGui('tot_music_competition_cancel').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 350 34 } text = "TOT_MUSIC_COMPETITION_CANCEL" enabled = "[GetScriptedGui('tot_music_competition_cancel').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_music_competition_cancel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						button_standard = { visible = "[And(And(GetScriptedGui('tot_music_competition_is_registered').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('tot_music_competition_band_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))), GetScriptedGui('tot_music_competition_cancel').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" size = { 350 34 } text = "TOT_MUSIC_COMPETITION_CANCEL" enabled = "[GetScriptedGui('tot_music_competition_cancel').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('tot_music_competition_cancel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						textbox = { visible = "[GetScriptedGui('tot_music_competition_is_qualifying').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 350 18 } text = "TOT_MUSIC_COMPETITION_QUALIFYING_DEADLINE" using = fontsize_small align = left|nobaseline }
						textbox = { visible = "[GetScriptedGui('tot_music_competition_is_final').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 350 18 } text = "TOT_MUSIC_COMPETITION_FINAL_DEADLINE" using = fontsize_small align = left|nobaseline }
						textbox = { visible = "[GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 350 20 } text = "TOT_MUSIC_COMPETITION_BAND_REPRESENTATIVE" using = fontsize_small align = left|nobaseline }
						scrollbox = {
							visible = "[GetScriptedGui('tot_music_competition_track_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							size = { 350 148 }
							blockoverride "scrollbox_content" {
								flowcontainer = {
