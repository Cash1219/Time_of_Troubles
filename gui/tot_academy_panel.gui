types tot_character_panel_types
{
	type tot_character_capacity_summary = widget {
		size = { 250 80 }
		tooltip = "TOT_CLUB_CAPACITY_TOOLTIP"

		background = {
			using = entry_bg_simple
		}

		hbox = {
			margin = { 10 5 }
			spacing = 9

			icon = {
				parentanchor = vcenter
				texture = "gfx/interface/icons/topbar/club_capacity.dds"
				size = { 26 26 }
			}
			position = { 0 -20 }
			vbox = {
				parentanchor = vcenter
				spacing = 1
				textbox = {
					
					size = { 260 14 }
					text = "TOT_CHARACTER_CAPACITY_HEADER"
					using = fontsize_very_small
					align = left|nobaseline
				}

				textbox = {
					size = { 260 20 }
					raw_text = "#bold 已占用 @bur![GetPlayer.MakeScope.ScriptValue('tot_club_capacity_usage')|1]/[GetPlayer.MakeScope.ScriptValue('tot_club_capacity')|1]#!"
					using = fontsize_medium
					align = left|nobaseline
				}

				textbox = {
					size = { 260 14 }
					text = "TOT_CHARACTER_CABINET_SEATS"
					using = fontsize_very_small
					align = left|nobaseline
				}
			}
		}
	}
	type tot_character_minister_slot = widget {
		size = { 332 176 }

		background = {
			using = entry_bg_fancy
		}

		block "selected_overlay" {}

		vbox = {
			margin = { 10 8 }
			spacing = 3

			textbox = {
				size = { 308 18 }
				using = fontsize_medium
				default_format = "#v"
				align = left|nobaseline

				block "slot_title" {
					text = "TOT_CHARACTER_SLOT_STUDENT"
				}
			}

			textbox = {
				size = { 308 15 }
				using = fontsize_very_small
				align = left|nobaseline
				elide = right

				block "slot_hint" {
					text = "TOT_CHARACTER_SLOT_STUDENT_HINT"
				}
			}

			textbox = {
				size = { 308 14 }
				text = "TOT_CHARACTER_CORE_CAPACITY"
				using = fontsize_very_small
				align = left|nobaseline
				block "capacity_tooltip" {
					tooltip = "TOT_CHARACTER_CORE_CAPACITY_TOOLTIP"
				}
			}

			textbox = {
				size = { 308 28 }
				using = fontsize_very_small
				using = entry_bg_simple
				default_format = "#P"
				align = left
				multiline = yes
				margin = { 6 1 }

				block "slot_effects" {
					text = "TOT_CHARACTER_SLOT_STUDENT_EFFECTS"
				}
			}

			widget = {
				size = { 308 54 }

				background = {
					using = dark_area
				}

				block "holder_content" {}
			}

			hbox = {
				parentanchor = hcenter
				spacing = 8

				block "select_button" {}
				block "remove_button" {}
			}
		}
	}

	# Kept adjacent to the core slot template so the honorary cards are registered
	# before the minister panel instantiates them.
	type tot_character_honorary_slot = widget {
		size = { 332 176 }

		background = {
			using = entry_bg_fancy
		}

		block "selected_overlay" {}

		vbox = {
			margin = { 10 8 }
			spacing = 3

			textbox = {
				size = { 308 18 }
				using = fontsize_medium
				default_format = "#v"
				align = left|nobaseline
				block "slot_title" { text = "TOT_HONORARY_CLUB_ADVISER" }
			}

			textbox = {
				size = { 308 15 }
				using = fontsize_very_small
				align = left|nobaseline
				elide = right
				block "slot_hint" { text = "TOT_HONORARY_SLOT_HINT" }
			}

			textbox = {
				size = { 308 14 }
				text = "TOT_HONORARY_CAPACITY"
				using = fontsize_very_small
				align = left|nobaseline
				tooltip = "TOT_CHARACTER_CAPACITY_HONORARY_REQUIRED"
			}

			textbox = {
				size = { 308 28 }
				using = fontsize_very_small
				using = entry_bg_simple
				default_format = "#P"
				align = left
				multiline = yes
				margin = { 6 1 }
				block "slot_effects" { text = "TOT_HONORARY_CLUB_ADVISER_EFFECT" }
			}

			widget = {
				size = { 308 54 }
				background = { using = dark_area }
				block "holder_content" {}
			}

			hbox = {
				parentanchor = hcenter
				spacing = 8
				block "select_button" {}
				block "remove_button" {}
			}
		}
	}

	type tot_character_honorary_holder = widget {
		datacontext = "[Scope.GetCharacter]"
		size = { 308 54 }
		hbox = {
			parentanchor = center
			spacing = 8
			widget = {
				size = { 62 54 }
				background = { texture = "gfx/interface/icons/character_icons/character_frame.dds" size = { 50 50 } parentanchor = center }
				character_portrait_small2 = { parentanchor = center blockoverride "show_hat" {} blockoverride "highlight" {} blockoverride "rank_icon" {} }
				widget = {
					visible = "[Character.GetInterestGroup.IsValid]"
					parentanchor = bottom|left
					position = { -5 2 }
					size = { 24 24 }
					datacontext = "[Character.GetInterestGroup]"
					icon = { parentanchor = center texture = "[InterestGroup.GetTexture]" size = { 22 22 } tooltipwidget = { FancyTooltip_IG = {} } }
				}
				widget = {
					parentanchor = bottom|right
					position = { 5 2 }
					size = { 24 24 }
					datacontext = "[Character.GetIdeology]"
					icon = { parentanchor = center texture = "[Ideology.GetTexture]" size = { 22 22 } tooltipwidget = { FancyTooltip_Ideology = {} } }
				}
			}
			vbox = {
				size = { 188 52 }
				parentanchor = vcenter
				spacing = 2
				textbox = { size = { 188 18 } raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!" using = fontsize_small align = left|nobaseline elide = right }
				textbox = { size = { 188 14 } raw_text = "[Character.GetPrimaryRoleTitle]" using = fontsize_very_small align = left|nobaseline elide = right }
			}
		}
	}

	type tot_character_candidate_item = widget {
		datacontext = "[Scope.GetCharacter]"

		size = { 1088 125 }

		using = entry_bg_fancy

		tooltipwidget = {
			FancyTooltip_Character = {}
		}

		hbox = {
			margin = { 12 5 }
			spacing = 12

			widget = {
				size = { 106 96 }

				widget = {
					size = { 96 96 }
					parentanchor = center

					background = {
						texture = "gfx/interface/icons/character_icons/character_frame.dds"
						size = { 92 92 }
						parentanchor = center
					}

					character_portrait_large = {
						parentanchor = center
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
						blockoverride "rank_icon" {}
					}
				}

				widget = {
					visible = "[Character.GetInterestGroup.IsValid]"
					size = { 38 38 }
					parentanchor = bottom|left
					position = { -7 2 }
					datacontext = "[Character.GetInterestGroup]"

					icon = {
						parentanchor = center
						texture = "[InterestGroup.GetTexture]"
						size = { 36 36 }

						tooltipwidget = {
							FancyTooltip_IG = {}
						}
					}
				}

				widget = {
					size = { 38 38 }
					parentanchor = bottom|right
					position = { 7 2 }
					datacontext = "[Character.GetIdeology]"

					icon = {
						parentanchor = center
						texture = "[Ideology.GetTexture]"
						size = { 36 36 }

						tooltipwidget = {
							FancyTooltip_Ideology = {}
						}
					}
				}
			}

			widget = {
				size = { 794 96 }

				vbox = {
					parentanchor = vcenter
					spacing = 4

					hbox = {
						size = { 794 24 }
						spacing = 10

						textbox = {
							size = { 580 24 }
							raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!"
							using = fontsize_large
							align = left|nobaseline
							elide = right
						}

						textbox = {
							size = { 204 18 }
							parentanchor = vcenter
							raw_text = "[SelectLocalization(Character.IsHistorical, 'HISTORICAL_FILTER_NAME', 'NON_HISTORICAL_FILTER_NAME')]"
							using = fontsize_very_small
							align = right|nobaseline
							elide = right
						}
					}

					textbox = {
						size = { 794 17 }
						raw_text = "#title [Character.GetPrimaryRoleTitle]#!"
						using = fontsize_small
						align = left|nobaseline
						elide = right
					}

					hbox = {
						visible = no
						size = { 794 36 }
						spacing = 8

						widget = {
							size = { 320 36 }
							background = {
								using = entry_bg_simple
							}

							widget = {
								visible = "[Character.GetInterestGroup.IsValid]"
									size = { 320 36 }
								datacontext = "[Character.GetInterestGroup]"

								hbox = {
									parentanchor = center
									spacing = 6

									icon = {
										parentanchor = vcenter
										texture = "[InterestGroup.GetTexture]"
										size = { 28 28 }

										tooltipwidget = {
											FancyTooltip_IG = {}
										}
									}

									textbox = {
										size = { 272 18 }
										raw_text = "#v [InterestGroup.GetNameNoFormatting]#!"
										using = fontsize_small
										align = left|nobaseline
										elide = right
									}
								}
							}

							textbox = {
								visible = "[Not(Character.GetInterestGroup.IsValid)]"
								size = { 320 16 }
								parentanchor = center
								text = "-"
								using = fontsize_very_small
								align = center|nobaseline
							}
						}

						widget = {
							size = { 320 36 }
							background = {
								using = entry_bg_simple
							}

							widget = {
									size = { 320 36 }
								datacontext = "[Character.GetIdeology]"

								hbox = {
									parentanchor = center
									spacing = 6

									icon = {
										parentanchor = vcenter
										texture = "[Ideology.GetTexture]"
										size = { 28 28 }

										tooltipwidget = {
											FancyTooltip_Ideology = {}
										}
									}

									textbox = {
										size = { 272 18 }
										raw_text = "#v [Ideology.GetNameNoFormatting]#!"
										using = fontsize_small
										align = left|nobaseline
										elide = right
									}
								}
							}

							textbox = {
								visible = no
								size = { 320 16 }
								parentanchor = center
								text = "-"
								using = fontsize_very_small
								align = center|nobaseline
							}
						}
					}
				}
			}

			widget = {
				size = { 140 96 }

				vbox = {
					parentanchor = center
					spacing = 4

					block "candidate_action_block" {}

					textbox = {
						size = { 132 16 }
						using = fontsize_very_small
						align = center|nobaseline
						elide = right

						block "appoint_hint" {
							text = "TOT_CHARACTER_ASSIGN_STUDENT"
						}
					}
				}
			}
		}
	}
}

window = {
	name = "tot_character_window"
	parentanchor = center
	position = { -100 0 }
	size = { 1300 950 }
	layer = windows_layer
	filter_mouse = all
	allow_outside = yes
	alwaystransparent = no

	using = Window_Background
	using = Window_Decoration

	movable = yes
	visible = "[GetVariableSystem.Exists('tot_character_panel_visible')]"

	datacontext = "[GetPlayer]"

	state = {
		name = refresh_character_panel
		trigger_on_create = yes
		on_finish = "[GetVariableSystem.Set( 'tot_character_system_page', 'ministers' )]"
		on_finish = "[GetVariableSystem.Set( 'tot_character_minister_slot', 'student_council' )]"
		on_finish = "[GetVariableSystem.Set( 'tot_character_filters', 'yes' )]"
		on_finish = "[GetScriptedGui('tot_character_filter_default').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	vbox = {
		restrictparent_min = yes
		using = Window_Margins
		spacing = 8

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "TOT_CHARACTER_PANEL_TITLE"
			}

			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Toggle('tot_character_panel_visible')]"
			}
		}

		widget = {
			size = { 1510 38 }
			tab_buttons = {
				size = { 1400 38 }
				blockoverride "first_button" { text = "TOT_CHARACTER_TAB_MINISTERS" }
				blockoverride "first_button_selected" { text = "TOT_CHARACTER_TAB_MINISTERS" }
				blockoverride "first_button_tooltip" { tooltip = "TOT_CHARACTER_TAB_MINISTERS" }
				blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_system_page', 'ministers' )]" }
				blockoverride "first_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'ministers' )]" }
				blockoverride "first_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_system_page', 'ministers' ))]" }

				blockoverride "second_button" { text = "TOT_CHARACTER_TAB_GROWTH" }
				blockoverride "second_button_selected" { text = "TOT_CHARACTER_TAB_GROWTH" }
				blockoverride "second_button_tooltip" { tooltip = "TOT_CHARACTER_TAB_GROWTH" }
				blockoverride "second_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_system_page', 'growth' )]" }
				blockoverride "second_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'growth' )]" }
				blockoverride "second_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_system_page', 'growth' ))]" }

				blockoverride "third_button" { text = "TOT_CHARACTER_TAB_BONDS" }
				blockoverride "third_button_selected" { text = "TOT_CHARACTER_TAB_BONDS" }
				blockoverride "third_button_tooltip" { tooltip = "TOT_CHARACTER_TAB_BONDS" }
				blockoverride "third_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_system_page', 'bonds' )]" }
				blockoverride "third_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'bonds' )]" }
				blockoverride "third_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_system_page', 'bonds' ))]" }

				blockoverride "fourth_button" { text = "TOT_CHARACTER_TAB_ACTIVITIES" }
				blockoverride "fourth_button_selected" { text = "TOT_CHARACTER_TAB_ACTIVITIES" }
				blockoverride "fourth_button_tooltip" { tooltip = "TOT_CHARACTER_TAB_ACTIVITIES" }
				blockoverride "fourth_button_click" { onclick = "[GetVariableSystem.Set( 'tot_character_system_page', 'activities' )][GetVariableSystem.Set( 'tot_character_activity_tab', 'bands' )]" }
				blockoverride "fourth_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'activities' )]" }
				blockoverride "fourth_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_system_page', 'activities' ))]" }

				blockoverride "fifth_button_visibility" { visible = no }
				blockoverride "fifth_button_visibility_checked" { visible = no }
			}

			button_standard = {
				parentanchor = right|vcenter
				size = { 94 28 }
				text = "TOT_CHARACTER_SYSTEM_REFRESH"
				tooltip = "TOT_CHARACTER_SYSTEM_REFRESH_TOOLTIP"
				enabled = "[GetScriptedGui('tot_character_system_refresh').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('tot_character_system_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		widget = {
			size = { 1510 700 }

		widget = {
			visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'ministers' )]"
			size = { 1510 44 }

			widget = {
				size = { 336 44 }
				parentanchor = top|left
				position = { 0 -8 }

				tot_character_capacity_summary = {
					parentanchor = hcenter|vcenter
				}
			}

		}

		widget = {
			visible = "[GetVariableSystem.HasValue( 'tot_character_system_page', 'ministers' )]"
			size = { 1510 644 }
			position = { 0 52 }

			hbox = {
				spacing = 12

				widget = {
					size = { 352 644 }

					background = {
						using = entry_bg_fancy
					}

					vbox = {
						margin = { 10 10 }
						spacing = 8

						textbox = {
							size = { 352 22 }
							text = "TOT_CHARACTER_MINISTER_SLOT_HEADER"
							using = fontsize_large
							align = left|nobaseline
						}

						hbox = {
							size = { 332 28 }
							spacing = 4
							button = { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_minister_category', 'honorary' ))]" using = default_button_primary size = { 164 28 } text = "TOT_CHARACTER_MINISTER_CORE_TAB" onclick = "[GetVariableSystem.Set( 'tot_character_minister_category', 'core' )]" }
							button = { visible = "[GetVariableSystem.HasValue( 'tot_character_minister_category', 'honorary' )]" using = default_button size = { 164 28 } text = "TOT_CHARACTER_MINISTER_CORE_TAB" onclick = "[GetVariableSystem.Set( 'tot_character_minister_category', 'core' )]" }
							button = { visible = "[GetVariableSystem.HasValue( 'tot_character_minister_category', 'honorary' )]" using = default_button_primary size = { 164 28 } text = "TOT_CHARACTER_MINISTER_HONORARY_TAB" onclick = "[GetVariableSystem.Set( 'tot_character_minister_category', 'honorary' )]" }
							button = { visible = "[Not(GetVariableSystem.HasValue( 'tot_character_minister_category', 'honorary' ))]" using = default_button size = { 164 28 } text = "TOT_CHARACTER_MINISTER_HONORARY_TAB" onclick = "[GetVariableSystem.Set( 'tot_character_minister_category', 'honorary' )]" }
						}

						widget = {
							size = { 352 550 }
							scrollbox = {
								visible = "[Not(GetVariableSystem.HasValue( 'tot_character_minister_category', 'honorary' ))]"
								size = { 352 550 }

							blockoverride "scrollbox_content" {
								vbox = {
									spacing = 12

									tot_character_minister_slot = {
									
										blockoverride "selected_overlay" {
											icon = {
												visible = "[GetVariableSystem.HasValue( 'tot_character_minister_slot', 'student_council' )]"
												using = highlighted_square_selection
												parentanchor = center
												
											}
										}
										blockoverride "slot_title" {
											text = "TOT_CHARACTER_SLOT_STUDENT"
										}
										blockoverride "slot_hint" {
											text = "TOT_CHARACTER_SLOT_STUDENT_HINT"
										}
										blockoverride "slot_effects" {
											text = "TOT_CHARACTER_SLOT_STUDENT_EFFECTS"
										}
										blockoverride "capacity_tooltip" { tooltip = "TOT_CHARACTER_CORE_CAPACITY_TOOLTIP_STUDENT" }
										blockoverride "holder_content" {
											widget = {
												visible = "[GetScriptedGui('tot_has_student_council_president').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												size = { 296 60 }
												datacontext = "[GetPlayer.MakeScope.Var('tot_student_council_president').GetCharacter]"

												hbox = {
													parentanchor = center
													spacing = 8

													widget = {
														size = { 60 60 }

														background = {
															texture = "gfx/interface/icons/character_icons/character_frame.dds"
															size = { 56 56 }
															parentanchor = center
														}

														character_portrait_small2 = {
															parentanchor = center
															blockoverride "show_hat" {}
															blockoverride "highlight" {}
															blockoverride "rank_icon" {}
														}
													}

													vbox = {
														size = { 190 58 }
														parentanchor = vcenter
														spacing = 2

														textbox = {
															size = { 190 18 }
															raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!"
															using = fontsize_small
															align = left|nobaseline
															elide = right
														}

														textbox = {
															size = { 190 14 }
															raw_text = "[Character.GetPrimaryRoleTitle]"
															using = fontsize_very_small
															align = left|nobaseline
															elide = right
														}
													}

													hbox = {
														parentanchor = vcenter
														spacing = 5

														widget = {
															visible = "[Character.GetInterestGroup.IsValid]"
															size = { 20 20 }
															datacontext = "[Character.GetInterestGroup]"

															icon = {
																parentanchor = center
																texture = "[InterestGroup.GetTexture]"
																size = { 20 20 }

																tooltipwidget = {
																	FancyTooltip_IG = {}
																}
															}
														}

														widget = {
															size = { 20 20 }
															datacontext = "[Character.GetIdeology]"

															icon = {
																parentanchor = center
																texture = "[Ideology.GetTexture]"
																size = { 20 20 }

																tooltipwidget = {
																	FancyTooltip_Ideology = {}
																}
															}
														}
													}
												}
											}

											widget = {
												visible = "[Not(GetScriptedGui('tot_has_student_council_president').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
												size = { 296 60 }

												textbox = {
													size = { 260 18 }
													parentanchor = center
													text = "TOT_CHARACTER_SLOT_EMPTY"
													using = fontsize_small
													align = center|nobaseline
												}
											}
										}
										blockoverride "select_button" {
											button_standard = {
												size = { 96 30 }
												text = "TOT_CHARACTER_SLOT_SELECT"
												onclick = "[GetVariableSystem.Set( 'tot_character_minister_slot', 'student_council' )]"
											}
										}
										blockoverride "remove_button" {
											button_standard = {
												visible = "[GetScriptedGui('tot_has_student_council_president').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												size = { 96 30 }
												text = "TOT_CHARACTER_SLOT_REMOVE"
												enabled = "[GetScriptedGui('tot_remove_student_council_president').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onclick = "[GetScriptedGui('tot_remove_student_council_president').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onclick = "[GetScriptedGui('tot_refresh_student_council_candidates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
										}
									}

									tot_character_minister_slot = {
										blockoverride "selected_overlay" {
											icon = {
												visible = "[GetVariableSystem.HasValue( 'tot_character_minister_slot', 'discipline' )]"
												using = highlighted_square_selection
												parentanchor = center
												size = { 96% 96% }
											}
										}
										blockoverride "slot_title" {
											text = "TOT_CHARACTER_SLOT_DISCIPLINE"
										}
										blockoverride "slot_hint" {
											text = "TOT_CHARACTER_SLOT_DISCIPLINE_HINT"
										}
