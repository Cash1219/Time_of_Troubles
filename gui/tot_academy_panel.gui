				widget = {
					size = { 1146 644 }
					position = { 0 -14 }
					
					background = {
						using = entry_bg_fancy
					}

						vbox = {
							margin = { 10 10 }
							spacing = 8

							vbox = {
								visible = no
								size = { 1124 0 }
								spacing = 2

								textbox = {
									size = { 1124 18 }
									text = "TOT_CHARACTER_MINISTER_CANDIDATES_HEADER"
									using = fontsize_large
									align = left|nobaseline
								}

								textbox = {
