								textbox = {
									visible = "[GetVariableSystem.HasValue( 'tot_character_minister_slot', 'chief_of_staff' )]"
									size = { 1124 14 }
									text = "TOT_CHARACTER_MINISTER_CURRENT_TARGET_CHIEF_OF_STAFF"
									using = fontsize_small
									align = left|nobaseline
									elide = right
								}
							}

						widget = {
							size = { 1124 128 }
							
							flowcontainer = {
								direction = vertical

								background = {
									using = dropdown_background
									margin = { 0 -2 }
								}

								section_header_button = {
									blockoverride "left_text" {
										text = "FILTERS"
										fontsize_min = 12
										elide = right
									}

									blockoverride "right_text" {
										section_header_right_text = {
											text = "TOT_CHARACTER_CANDIDATE_COUNT"
											using = fontsize_very_small
										}
									}

									blockoverride "onclick" {
										onclick = "[GetVariableSystem.Toggle( 'tot_character_filters' )]"
									}

									blockoverride "onclick_showmore" {
										visible = "[Not(GetVariableSystem.Exists( 'tot_character_filters' ))]"
									}

									blockoverride "onclick_showless" {
										visible = "[GetVariableSystem.Exists( 'tot_character_filters' )]"
									}
								}

								flowcontainer = {
									visible = "[GetVariableSystem.Exists( 'tot_character_filters' )]"
									parentanchor = hcenter
									margin_top = 4
									margin_bottom = 6
									direction = vertical

									building_browser_filter_line = {
										parentanchor = hcenter
										blockoverride "line_background" {}

										blockoverride "line_size" {
											size = { 1098 38 }
										}

										blockoverride "filter_line_label" {
											text = "TOT_CHARACTER_FILTER_DUTY"
										}

										blockoverride "filter_line_buttons" {
											building_browser_filter_line_button = {
												text = "ALL"
												align = hcenter
												blockoverride "line_button_onclick" { onclick = "[GetScriptedGui('tot_character_filter_duty_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
												blockoverride "line_button_icon_texture" { visible = no }
												blockoverride "line_button_selected" {
													visible = "[GetScriptedGui('tot_character_filter_duty_all_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												}
