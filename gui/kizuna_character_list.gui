types kizuna_list_type #角色列表
{
	type kizuna_character_widget = flowcontainer {
		direction = vertical

		divider_clean = {}
		widget = {
		
			parentanchor = hcenter
			size = { 1040 76 }
			datacontext = "[Scope.GetCharacter]"
			visible = "[Scope.GetCharacter.IsValid]"
			
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				
				hbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding

					margin_left = 10

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = growing

						### LEADER
						widget = {
							size = { 90 90 }

							character_portrait_medium = {
								datacontext = "[Scope.AccessCharacter]"
								using = tooltip_es
								blockoverride "show_hat" {}
								parentanchor = vcenter
								blockoverride "highlight" {}
								blockoverride "rank_icon" {}
							}

						ig_button = {
							visible = "[Character.GetInterestGroup.IsValid]"
							datacontext = "[Character.GetInterestGroup]"
								parentanchor = bottom|left
								block "ig_button_size" {
									size = { 35 35 }
								}
								using = tooltip_ws
								blockoverride "in_government_icon" {}
							}

							icon = {
								datacontext = "[Character.GetIdeology]"
								texture = "[Ideology.GetTexture]"
								tooltipwidget = {
									FancyTooltip_Ideology = {}
								}
								size = { 35 35 }
								parentanchor = bottom|right
							}
						}
					}
					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						margin_left = 1

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = growing

							background = {
								using = dark_area

								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_center.dds"
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									blend_mode = alphamultiply
								}
							}

							hbox = {
								
								layoutpolicy_horizontal = expanding
								### NAME
								textbox = {
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									text = "[Character.GetFullNameNoFormatting]"
									default_format = "#v"
									align = left
									using = regular_font
									block "highlight_name" {}
									elide = right
								}
								container = {
									parentanchor = hcenter
									maximumsize = { 540 -1 }
									minimumsize = { 300 -1 }
									flowcontainer = {
										direction = vertical
										spacing = 2
										textbox = {
											text = "TOT_KIZUNA_ACTIVE_LABEL"
											size = { 260 22 }
											align = left|nobaseline
											using = fontsize_small
										}
										textbox = {
											visible = "[GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
											text = "TOT_KIZUNA_ACTIVE_YES"
											size = { 260 24 }
											align = left|nobaseline
											using = fontsize_small
											default_format = "#P"
										}
										textbox = {
											visible = "[Not(GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
											text = "TOT_KIZUNA_ACTIVE_NO"
											size = { 260 24 }
											align = left|nobaseline
											using = fontsize_small
											default_format = "#N"
										}
									}
								}
								vbox = {
								layoutpolicy_horizontal = growing
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 10 }
										visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
									}
									textbox = {
									position = { -30 50 }
									visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
									layoutpolicy_horizontal = expanding
									size = { 90 24 }
									text = "在政府中"
									align = center|nobaseline
									using = fontsize_small
									block "highlight_name" {}
									elide = right
								}
								}
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 -30 }
										visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
									}
									textbox = {
									position = { -30 10 }
									visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
									layoutpolicy_horizontal = expanding
									size = { 90 24 }
									text = "不在政府"
									align = center|nobaseline
									using = fontsize_small
									block "highlight_name" {}
									elide = right
								}
									
								}
							}
							}
							
						}
						
						
						

					}
					
				}
			}
		}
	}

	
	# Compact card used by the domestic faction, profession and specialty lists.
	type tot_kizuna_domestic_character = widget {
		size = { 350 128 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"
		using = entry_bg_fancy

		tooltipwidget = {
			FancyTooltip_Character = {}
		}

		hbox = {
			margin = { 10 8 }
			spacing = 8

			widget = {
				size = { 108 112 }

				character_portrait_large = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
				}

				ig_button = {
					visible = "[Character.GetInterestGroup.IsValid]"
					datacontext = "[Character.GetInterestGroup]"
					parentanchor = bottom|left
					block "ig_button_size" { size = { 42 42 } }
					using = tooltip_ws
					blockoverride "in_government_icon" {}
				}

				icon = {
					datacontext = "[Character.GetIdeology]"
					parentanchor = bottom|right
					size = { 42 42 }
					texture = "[Ideology.GetTexture]"
					tooltipwidget = { FancyTooltip_Ideology = {} }
				}
			}

			vbox = {
				size = { 214 108 }
				parentanchor = vcenter
				spacing = 4

				hbox = {
					size = { 214 108 }
					spacing = 4

					vbox = {
						size = { 150 108 }
						spacing = 4

						textbox = {
							size = { 150 28 }
							position = { 8 0 }
							raw_text = "#BOLD [Character.GetFullNameNoFormatting]#!"
							using = fontsize_large
							align = left|nobaseline
							elide = right
						}

						textbox = {
							size = { 150 20 }
							raw_text = "#title [Character.GetPrimaryRoleTitle]#!"
							using = fontsize_small
							align = left|nobaseline
							elide = right
						}
					}

					widget = {
						size = { 60 108 }
						tooltip = "[SelectLocalization(GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End), 'TOT_KIZUNA_ACTIVE_YES', 'TOT_KIZUNA_ACTIVE_NO')]"

						textbox = {
							visible = "[GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
							parentanchor = center
							size = { 60 44 }
							raw_text = "√"
							default_format = "#P"
							using = fontsize_large
							align = center|nobaseline
						}

						textbox = {
							visible = "[Not(GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
							parentanchor = center
							size = { 60 44 }
							raw_text = "×"
							default_format = "#N"
							using = fontsize_large
							align = center|nobaseline
						}
					}
				}
			}
		}
	}

	type tot_band_member_character_base = widget {
		size = { 500 138 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"
		background = { using = entry_bg_simple }
		flowcontainer = {
			margin = { 12 8 }
			spacing = 12
			widget = {
				size = { 116 116 }
				character_portrait_medium = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
					blockoverride "additional_icons" {}
				}
				widget = {
					visible = "[Character.GetInterestGroup.IsValid]"
					parentanchor = bottom|left
					position = { -10 2 }
					size = { 44 44 }
					datacontext = "[Character.GetInterestGroup]"
					icon = { parentanchor = center size = { 42 42 } texture = "[InterestGroup.GetTexture]" tooltipwidget = { FancyTooltip_IG = {} } }
				}
				widget = {
					parentanchor = bottom|right
					position = { 10 2 }
					size = { 44 44 }
					datacontext = "[Character.GetIdeology]"
					icon = { parentanchor = center size = { 42 42 } texture = "[Ideology.GetTexture]" tooltipwidget = { FancyTooltip_Ideology = {} } }
				}
				}
			flowcontainer = {
				direction = vertical
				spacing = 4
				size = { 260 116 }
				textbox = { text = "[Character.GetFullNameNoFormatting]" default_format = "#v" using = fontsize_large size = { 260 28 } align = left|nobaseline elide = right }
				flowcontainer = {
					spacing = 6
					icon = { visible = "[GetScriptedGui('tot_band_character_is_vocalist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_vocal.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_guitarist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_guitar_center.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_bassist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_bass.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_keyboardist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_keyboard.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_drummer').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_drums.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_dj').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_keyboard.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
				}
				textbox = { text = "[Character.GetPrimaryRoleTitle]" size = { 260 22 } using = fontsize_small align = left|nobaseline elide = right }
				textbox = { visible = "[GetScriptedGui('tot_band_character_has_specialty').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" raw_text = "特长：[Character.GetCustom('tot_band_specialty_summary')]" size = { 260 22 } using = fontsize_small align = left|nobaseline elide = right }
			}
			flowcontainer = {
				direction = vertical
				spacing = 4
				size = { 110 116 }
				button_standard = {
					text = "TOT_BAND_REMOVE"
					size = { 110 52 }
					enabled = "[GetScriptedGui('tot_band_remove_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					onclick = "[GetScriptedGui('tot_band_remove_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_remove_character').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}
			}
		}
	}

	type tot_band_candidate_character_base = widget {
		# Match the character-system candidate cards: one readable row per candidate.
		size = { 900 136 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"
		background = { using = entry_bg_fancy }
		flowcontainer = {
			margin = { 10 8 }
			spacing = 12
			widget = {
					size = { 116 116 }
				character_portrait_large = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "highlight" {}
					blockoverride "rank_icon" {}
					blockoverride "additional_icons" {}
				}
				widget = {
					visible = "[Character.GetInterestGroup.IsValid]"
					parentanchor = bottom|left
					position = { -10 2 }
					size = { 44 44 }
					datacontext = "[Character.GetInterestGroup]"
					icon = { parentanchor = center size = { 42 42 } texture = "[InterestGroup.GetTexture]" tooltipwidget = { FancyTooltip_IG = {} } }
				}
				widget = {
					parentanchor = bottom|right
					position = { 10 2 }
					size = { 44 44 }
					datacontext = "[Character.GetIdeology]"
					icon = { parentanchor = center size = { 42 42 } texture = "[Ideology.GetTexture]" tooltipwidget = { FancyTooltip_Ideology = {} } }
				}
			}
				flowcontainer = {
					direction = vertical
					spacing = 3
					textbox = { text = "[Character.GetFullNameNoFormatting]" default_format = "#v" using = fontsize_medium size = { 540 24 } align = left|nobaseline elide = right }
				flowcontainer = {
					spacing = 3
					icon = { visible = "[GetScriptedGui('tot_band_character_is_vocalist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_vocal.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_guitarist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_guitar_center.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_bassist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_bass.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_keyboardist').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_keyboard.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_drummer').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_drums.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
					icon = { visible = "[GetScriptedGui('tot_band_character_is_dj').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 28 28 } texture = "gfx/interface/icons/band_role_icons/tot_band_role_keyboard.dds" tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
				}
				textbox = { text = "[Character.GetPrimaryRoleTitle]" size = { 540 20 } using = fontsize_small align = left|nobaseline elide = right }
				textbox = { visible = "[GetScriptedGui('tot_band_character_has_specialty').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" raw_text = "特长：[Character.GetCustom('tot_band_specialty_summary')]" size = { 540 22 } using = fontsize_small align = left|nobaseline elide = right }
			}
			block "appoint_buttons" {
				button_standard = {
					size = { 192 42 }
					text = "TOT_BAND_APPOINT_OR_EDIT"
					enabled = "[GetScriptedGui('tot_band_1_assign_selected_role').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					onclick = "[GetScriptedGui('tot_band_1_assign_selected_role').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_1_assign_selected_role').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}
			}
		}
	}

	type tot_band_1_member_character = tot_band_member_character_base {}
	type tot_band_1_candidate_character = tot_band_candidate_character_base {}

	# The character panel follows the minister workflow: choose a position first,
	# then use this single command to appoint the highlighted candidate.
	type tot_band_1_candidate_character_selected = tot_band_candidate_character_base {
		blockoverride "appoint_buttons" {
			button_standard = {
				size = { 192 42 }
				text = "TOT_BAND_APPOINT_OR_EDIT"
				enabled = "[GetScriptedGui('tot_band_1_assign_selected_role').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
				onclick = "[GetScriptedGui('tot_band_1_assign_selected_role').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
				tooltip = "[GetScriptedGui('tot_band_1_assign_selected_role').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
			}
		}
	}
