flowcontainer = {
	name = "widget_je_kizuna_character_list"
	ignoreinvisible = yes
	direction = vertical
	spacing = 8

	state = {
		name = refresh_kizuna_lists
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	widget = {
		size = { 520 38 }
		tab_buttons = {
			blockoverride "first_button" { text = "KIZUNA_TAB_FACTION" }
			blockoverride "first_button_selected" { text = "KIZUNA_TAB_FACTION" }
			blockoverride "first_button_tooltip" { tooltip = "KIZUNA_TAB_FACTION" }
			blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'faction' )]" }
			blockoverride "first_button_visibility" { visible = "[Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' ), Not(Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ), GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' ))))]" }
			blockoverride "first_button_visibility_checked" { visible = "[And(Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' )), Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ), GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' )))]" }
			blockoverride "second_button" { text = "KIZUNA_TAB_PROFESSION" }
			blockoverride "second_button_selected" { text = "KIZUNA_TAB_PROFESSION" }
			blockoverride "second_button_tooltip" { tooltip = "KIZUNA_TAB_PROFESSION" }
			blockoverride "second_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'profession' )]" }
			blockoverride "second_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' )]" }
			blockoverride "second_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ))]" }
			blockoverride "third_button" { text = "KIZUNA_TAB_SPECIALTY" }
			blockoverride "third_button_selected" { text = "KIZUNA_TAB_SPECIALTY" }
			blockoverride "third_button_tooltip" { tooltip = "KIZUNA_TAB_SPECIALTY" }
			blockoverride "third_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'specialty' )]" }
			blockoverride "third_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' )]" }
			blockoverride "third_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' ))]" }
			blockoverride "fourth_button_visibility" { visible = no }
			blockoverride "fourth_button_visibility_checked" { visible = no }
			blockoverride "fifth_button_visibility" { visible = no }
			blockoverride "fifth_button_visibility_checked" { visible = no }
		}
	}

	scrollbox = {
		size = { 540 720 }
		blockoverride "scrollbox_content" {
			flowcontainer = {
				direction = vertical
				spacing = 6
				flowcontainer = {
					visible = "[Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' ), Not(Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ), GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' ))))]"
					direction = vertical
	
						flowcontainer = {
