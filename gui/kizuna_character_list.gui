	type tot_band_role_slot_portrait = widget {
		size = { 100 190 }
		datacontext = "[Scope.AccessCharacter]"
		visible = "[Scope.AccessCharacter.IsValid]"

		background = { using = entry_bg_simple }

		flowcontainer = {
			parentanchor = hcenter
			direction = vertical
			spacing = 2
			margin = { 4 4 }
			widget = {
				size = { 92 104 }
				background = { using = dark_area }

				character_portrait_medium = {
					parentanchor = center
					blockoverride "show_hat" {}
					blockoverride "rank_icon" {}
					blockoverride "highlight" {}
				}
			}
			textbox = {
				size = { 92 22 }
				text = "[Character.GetFullNameNoFormatting]"
				using = fontsize_small
				align = center|nobaseline
				elide = right
			}
			textbox = {
				size = { 92 18 }
				text = "[Character.GetPrimaryRoleTitle]"
				using = fontsize_very_small
				align = center|nobaseline
				elide = right
			}
			button_standard = {
				text = "TOT_BAND_REMOVE"
				size = { 92 34 }
				enabled = "[GetScriptedGui('tot_band_remove_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
						onclick = "[GetScriptedGui('tot_band_remove_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
				tooltip = "[GetScriptedGui('tot_band_remove_character').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
			}
		}
	}

