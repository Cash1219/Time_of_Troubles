	type tot_band_role_slot_empty = widget {
		size = { 96 164 }
		background = { using = entry_bg_simple }
		flowcontainer = {
			parentanchor = hcenter
			direction = vertical
			spacing = 4
			margin = { 6 6 }
			widget = {
				size = { 84 68 }
				background = { using = dark_area }
				textbox = {
					parentanchor = center
					size = { 84 28 }
					text = "TOT_BAND_ROLE_EMPTY"
					using = fontsize_small
					align = center|nobaseline
				}
			}
			textbox = { size = { 84 20 } text = "TOT_BAND_SLOT_VACANT" using = fontsize_small align = center|nobaseline }
			textbox = { size = { 84 18 } text = "TOT_BAND_SLOT_WAIT_ASSIGN" using = fontsize_very_small align = center|nobaseline }
		}
	}

	type tot_band_hq_jump_widget = widget {
		size = { 500 40 }
		datacontext = "[Scope.AccessBuilding]"
		visible = "[Building.IsValid]"

		button = {
			size = { 500 40 }
			using = default_button
			onclick = "[InformationPanelBar.OpenBuildingDetailsPanel(Building.AccessSelf)]"
			tooltip = "TOT_BAND_OPEN_HQ_TOOLTIP"

			icon = {
				parentanchor = left|vcenter
				position = { 10 0 }
				size = { 24 24 }
				texture = "gfx/interface/icons/building_icons/building_musical_instrument.dds"
			}

			textbox = {
				size = { 100% 100% }
				margin = { 40 0 }
				raw_text = "前往乐队总部：[Building.GetState.GetNameNoFormatting]"
				using = fontsize_small
				align = left|nobaseline
				elide = right
			}
		}
	}


}
types tot_kizuna_page_types {
	type tot_kizuna_page = flowcontainer {
	size = { 1420 630 }
	ignoreinvisible = yes
	direction = vertical
	spacing = 8

	state = {
		name = refresh_kizuna_lists
		trigger_on_create = yes
		on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_finish = "[GetVariableSystem.Set( 'tot_kizuna_page', 'faction' )]"
	}

		widget = {
			size = { 520 38 }
			tab_buttons = {
				blockoverride "first_button" { text = "KIZUNA_TAB_FACTION" }
				blockoverride "first_button_selected" { text = "KIZUNA_TAB_FACTION" }
				blockoverride "first_button_tooltip" { tooltip = "KIZUNA_TAB_FACTION" }
				blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'faction' )]" }
				blockoverride "first_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' )]" }
				blockoverride "first_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' ))]" }
				blockoverride "second_button" { text = "KIZUNA_TAB_PROFESSION" }
				blockoverride "second_button_selected" { text = "KIZUNA_TAB_PROFESSION" }
				blockoverride "second_button_tooltip" { tooltip = "KIZUNA_TAB_PROFESSION" }
				blockoverride "second_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'profession' )]" }
				blockoverride "second_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' )]" }
				blockoverride "second_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ))]" }
				blockoverride "third_button" { text = "KIZUNA_TAB_SPECIALTY" }
				blockoverride "third_button_selected" { text = "KIZUNA_TAB_SPECIALTY" }
				blockoverride "third_button_tooltip" { tooltip = "KIZUNA_TAB_SPECIALTY" }
				blockoverride "third_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'specialty' )]" }
				blockoverride "third_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' )]" }
				blockoverride "third_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' ))]" }
				blockoverride "fourth_button" { text = "KIZUNA_TAB_CODEX" }
				blockoverride "fourth_button_selected" { text = "KIZUNA_TAB_CODEX" }
				blockoverride "fourth_button_tooltip" { tooltip = "KIZUNA_TAB_CODEX" }
				blockoverride "fourth_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'codex' )][GetScriptedGui('tot_character_codex_scope_home').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "fourth_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'codex' )]" }
				blockoverride "fourth_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'codex' ))]" }
				blockoverride "fifth_button" { text = "KIZUNA_TAB_SUBJECT" }
				blockoverride "fifth_button_selected" { text = "KIZUNA_TAB_SUBJECT" }
				blockoverride "fifth_button_tooltip" { tooltip = "KIZUNA_TAB_SUBJECT" }
				blockoverride "fifth_button_click" { onclick = "[GetVariableSystem.Set( 'tot_kizuna_page', 'subject' )][GetScriptedGui('tot_character_codex_scope_subject').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "fifth_button_visibility" { visible = "[GetVariableSystem.HasValue( 'tot_kizuna_page', 'subject' )]" }
				blockoverride "fifth_button_visibility_checked" { visible = "[Not(GetVariableSystem.HasValue( 'tot_kizuna_page', 'subject' ))]" }
		}
	}

        flowcontainer = {
            visible = "[Not(Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'codex' ), GetVariableSystem.HasValue( 'tot_kizuna_page', 'subject' )))]"
            size = { 1420 590 }
            direction = horizontal
            spacing = 12
                scrollbox = {
                    size = { 264 590 }
                    blockoverride "scrollbox_content" {
                        flowcontainer = {
                            direction = vertical
                            spacing = 4
                            flowcontainer = {
                                visible = "[Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'faction' ), Not(Or(GetVariableSystem.HasValue( 'tot_kizuna_page', 'profession' ), GetVariableSystem.HasValue( 'tot_kizuna_page', 'specialty' ))))]"
                                direction = vertical
