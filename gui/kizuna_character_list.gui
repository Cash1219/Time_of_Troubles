						blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('tot_kizuna_057_toggle'))]" }
						blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('tot_kizuna_057_toggle')]" }
					}
					default_header_clean = {
