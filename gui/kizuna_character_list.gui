types kizuna_list_type #角色列表
{
	type kizuna_character_widget = flowcontainer {
		direction = vertical

		divider_clean = {}
		widget = {
		
			parentanchor = hcenter
			size = { 500 148 }
			datacontext = "[Scope.GetCharacter]"
			visible = "[Scope.GetCharacter.IsValid]"
			
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				
				hbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding

					margin_left = 10

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = growing

						### LEADER
						widget = {
							size = { 90 90 }

							character_portrait_medium = {
								datacontext = "[Scope.AccessCharacter]"
								using = tooltip_es
								blockoverride "show_hat" {}
								parentanchor = vcenter
								blockoverride "highlight" {}
								blockoverride "rank_icon" {}
							}

							ig_button = {
								datacontext = "[Character.GetInterestGroup]"
								parentanchor = bottom|left
								block "ig_button_size" {
									size = { 35 35 }
								}
								using = tooltip_ws
								blockoverride "in_government_icon" {}
							}

							icon = {
								datacontext = "[Character.GetIdeology]"
								texture = "[Ideology.GetTexture]"
								tooltipwidget = {
									FancyTooltip_Ideology = {}
								}
								size = { 35 35 }
								parentanchor = bottom|right
							}
						}
					}
					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						margin_left = 1

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = growing

							background = {
								using = dark_area

								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_center.dds"
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									blend_mode = alphamultiply
								}
							}

							hbox = {
								
								layoutpolicy_horizontal = expanding
								### NAME
								textbox = {
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									text = "[Character.GetFullNameNoFormatting]"
									default_format = "#v"
									align = left
									using = regular_font
									block "highlight_name" {}
									elide = right
								}
								container = {
									parentanchor = hcenter
									maximumsize = { 540 -1 }
									minimumsize = { 300 -1 }
									vbox = {
										spacing = 2
										textbox = {
											text = "TOT_KIZUNA_ACTIVE_LABEL"
											size = { 260 22 }
											align = left|nobaseline
											using = fontsize_small
										}
										textbox = {
											visible = "[GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
											text = "TOT_KIZUNA_ACTIVE_YES"
											size = { 260 24 }
											align = left|nobaseline
											using = fontsize_small
											default_format = "#P"
										}
										textbox = {
											visible = "[Not(GetScriptedGui('tot_kizuna_character_active').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
											text = "TOT_KIZUNA_ACTIVE_NO"
											size = { 260 24 }
											align = left|nobaseline
											using = fontsize_small
											default_format = "#N"
										}
									}
								}
								vbox = {
								layoutpolicy_horizontal = growing
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 10 }
										visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
									}
									textbox = {
									position = { -30 50 }
									visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
									layoutpolicy_horizontal = expanding
									size = { 90 24 }
									text = "在政府中"
									align = center|nobaseline
									using = fontsize_small
									block "highlight_name" {}
									elide = right
								}
								}
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 -30 }
										visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
									}
									textbox = {
									position = { -30 10 }
									visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
									layoutpolicy_horizontal = expanding
									size = { 90 24 }
									text = "不在政府"
									align = center|nobaseline
									using = fontsize_small
									block "highlight_name" {}
									elide = right
								}
									
								}
							}
							}
							
						}
						
						
						

					}
					
				}
			}
		}
	}

	
	type tot_band_1_member_character = widget {
		size = { 500 142 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"

		background = { using = entry_bg_simple }

		flowcontainer = {
			margin = { 12 10 }
			spacing = 12
			character_portrait_medium = {}
			flowcontainer = {
				direction = vertical
				spacing = 4
				size = { 250 118 }
				textbox = { text = "[Character.GetFullNameNoFormatting]" default_format = "#v" using = fontsize_medium size = { 250 28 } align = left|nobaseline elide = right }
				textbox = { text = "[Character.GetPrimaryRoleTitle]" using = fontsize_small size = { 250 20 } align = left|nobaseline elide = right }
				textbox = { raw_text = "乐队特长：[Character.GetCustom('tot_band_music_specialty_summary')]" using = fontsize_small size = { 250 20 } align = left|nobaseline elide = right }
				textbox = { raw_text = "当前岗位：[Character.GetCustom('tot_band_current_roles')]" using = fontsize_small size = { 250 38 } align = left|nobaseline multiline = yes tooltip = "TOT_BAND_ROLE_SUMMARY_TOOLTIP" }
			}
			flowcontainer = {
				direction = vertical
				spacing = 6
				size = { 118 118 }
				button_standard = {
					text = "TOT_BAND_EDIT_ROLE"
					size = { 118 42 }
					enabled = "[GetScriptedGui('tot_band_1_appoint_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					onclick = "[GetScriptedGui('tot_band_1_appoint_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_1_appoint_character').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}
				button_standard = {
					text = "TOT_BAND_REMOVE"
					size = { 118 42 }
					enabled = "[GetScriptedGui('tot_band_remove_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					onclick = "[GetScriptedGui('tot_band_remove_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
					tooltip = "[GetScriptedGui('tot_band_remove_character').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]"
				}
			}
		}
	}

