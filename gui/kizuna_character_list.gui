types kizuna_list_type #角色列表
{
	type kizuna_character_widget = flowcontainer {
		direction = vertical

		divider_clean = {}
		widget = {
		
			parentanchor = hcenter
			size = { 500 100 }
			datacontext = "[Scope.GetCharacter]"
			visible = "[Scope.GetCharacter.IsValid]"
			
			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				
				hbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding

					margin_left = 10

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = growing

						### LEADER
						widget = {
							size = { 90 90 }

							character_portrait_medium = {
								datacontext = "[Scope.AccessCharacter]"
								using = tooltip_es
								blockoverride "show_hat" {}
								parentanchor = vcenter
								blockoverride "highlight" {}
								blockoverride "rank_icon" {}
							}

							ig_button = {
								datacontext = "[Character.GetInterestGroup]"
								parentanchor = bottom|left
								block "ig_button_size" {
									size = { 35 35 }
								}
								using = tooltip_ws
								blockoverride "in_government_icon" {}
							}

							icon = {
								datacontext = "[Character.GetIdeology]"
								texture = "[Ideology.GetTexture]"
								tooltipwidget = {
									FancyTooltip_Ideology = {}
								}
								size = { 35 35 }
								parentanchor = bottom|right
							}
						}
					}
					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						margin_left = 1

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = growing

							background = {
								using = dark_area

								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_center.dds"
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									blend_mode = alphamultiply
								}
							}

							hbox = {
								
								layoutpolicy_horizontal = expanding
								### NAME
								textbox = {
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									text = "[Character.GetFullNameNoFormatting]"
									default_format = "#v"
									align = left
									using = regular_font
									block "highlight_name" {}
								}
								container = {
									parentanchor = hcenter
									maximumsize = { 540 -1 }
									minimumsize = { 300 -1 }
									dynamicgridbox = {
										datamodel = "[Character.AccessTraits]"
										datamodel_wrap = 3
										flipdirection = yes
										
										item = {
											flowcontainer = {
												margin = { 0 0 }
												using = tooltip_above
												alpha = "[TransparentIfTrue(CharacterTrait.IsDisabled)]"

												tooltipwidget = {
													FancyTooltip_CharacterTrait = {}
												}

												icon = {
													size = { 32 45 }
													parentanchor = vcenter
													texture = "[CharacterTrait.GetTexture]"
												}

												textbox = {
													text = "[CharacterTrait.GetNameNoFormatting]"
													margin_left = 5
													max_width = 130
													autoresize = yes
													elide = right
													parentanchor = vcenter
													align = left|nobaseline
													multiline = yes
													fontsize_min = 10
													using = fontsize_small
												}
											}
										}
									}
								}
								vbox = {
								layoutpolicy_horizontal = growing
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 10 }
										visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_opposition_icon.dds"
									}
									textbox = {
									position = { -30 50 }
									visible = "[GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
									layoutpolicy_horizontal = expanding
									size = { 100 30 }
									text = "在政府中"
									align = center|nobaseline
									using = fontsize_medium
									block "highlight_name" {}
									elide = right
								}
								}
								widget = {
									size = { 45 45 }
									icon = {
										position = { 0 -30 }
										visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
										parentanchor = center
										size = { 40 40 }
										texture = "gfx/interface/icons/generic_icons/in_government_icon.dds"
									}
									textbox = {
									position = { -30 10 }
									visible = "[Not(GetScriptedGui('get_is_in_government_type').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]"
									layoutpolicy_horizontal = expanding
									size = { 100 30 }
									text = "不在政府中"
									align = center|nobaseline
									using = fontsize_medium
									block "highlight_name" {}
									elide = right
								}
									
								}
							}
							}
							
						}
						
						
						

					}
					
				}
			}
		}
	}

	
}
flowcontainer = {
	name = "widget_je_kizuna_character_list"
	ignoreinvisible = yes
	
	flowcontainer = {
		visible = "[GetScriptedGui('kon_kizuna_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		direction = vertical
		
		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			
			}
			
			blockoverride "left_text" {
				text = "#v 轻音部#!"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('kon_kizuna_toggle')]"
			}
			blockoverride "onclick_showmore" {
			
				visible = "[Not(GetVariableSystem.Exists('kon_kizuna_toggle'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('kon_kizuna_toggle')]"
			}
				
		}
		
			default_header_clean = {
					name = "kon_kizuna_show" #樱高轻音部计数
					visible = "[GetVariableSystem.Exists('kon_kizuna_toggle')]"
					size = { 500 100 }
					
					blockoverride "text" {
						
						icon = {
								texture = "gfx/interface/icons/religion_icons/starbeat.dds"
								size = { 50 50 }
								position = { -50 -10 }
							}
							
						raw_text = "樱高轻音部 [AccessPlayer.MakeScope.ScriptValue('kon_kizuna_number')|=+D]"
						autoresize = yes
						multiline = yes
						using = fontsize_xl
						default_format = "#medium"
					}
					tooltip = "kon_kizuna_tooltip"		
				
				}
				
				default_header_clean = {
					name = "kon_kizuna_modifier" #樱高轻音部修正
					visible = "[GetVariableSystem.Exists('kon_kizuna_toggle')]"
					size = { 500 200 }
					
					blockoverride "text" {
						
						raw_text = "kon_kizuna_modifier_text"
						autoresize = yes
						multiline = yes
						using = fontsize_xl
						default_format = "#medium"
						
					}
							
				}
		fixedgridbox = {
			name = "kon_kizuna_character_list"
			visible = "[GetVariableSystem.Exists('kon_kizuna_toggle')]" #樱高轻音部角色列表
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('kon_kizuna_list')]"
			addcolumn = 200
			addrow = 100
			background = {
				texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
				color = { 0.69 0.47 0.33 1 }
				alpha = 0.4

				modify_texture = {
					using = texture_velvet
				}
			}
			item = {
				kizuna_character_widget = {}
				
			}
		}
		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			
			}
			blockoverride "left_text" {
				text = "#v 乐队#!"
				
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('band_kizuna_toggle')]"
			}
			blockoverride "onclick_showmore" {
			
				visible = "[Not(GetVariableSystem.Exists('band_kizuna_toggle'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('band_kizuna_toggle')]"
			}
				
			
		}
		
		default_header_clean = {
					name = "band_kizuna_show" #乐队计数
					visible = "[GetVariableSystem.Exists('band_kizuna_toggle')]"
					size = { 500 100 }
					blockoverride "text" {
						
						icon = {
								texture = "gfx/interface/icons/religion_icons/starbeat.dds"
								size = { 50 50 }
								position = { -50 -10 }
							}
						raw_text = "乐队 [AccessPlayer.MakeScope.ScriptValue('band_kizuna_number')|=+D]"
						autoresize = yes
						multiline = yes
						using = fontsize_xl
						default_format = "#medium"
						tooltip = "band_kizuna_tooltip"		
					}
									
									
				}
				
				button = {
					size = { 500 50 }
					default_progressbar_horizontal = {	
						visible = "[GetVariableSystem.Exists('band_kizuna_toggle')]"
						size = { 500 50 }
						tooltip = "band_kizuna_exp_progress_tooltip"
					
					parentanchor = vcenter
						blockoverride "values" {
							value = "50"
						}
						#icon = {
						#	position = { -10 -25 }
						#	size = { 520 100 }
						#	texture = "gfx/interface/progressbar/cohesion_bar.dds"
						#}
					textbox = {
						parentanchor = center
						size = { 100 100 }
						font = "OpenSans"
						fontsize = 14
						fontsize_min = 9
						align = center|nobaseline
						elide = right
						text = "band_kizuna_exp_progress"
					}
				}
				}
				
				button = {
					size = { 500 50 }
					default_progressbar_horizontal = {	
						visible = "[GetVariableSystem.Exists('band_kizuna_toggle')]"
						size = { 500 50 }
						tooltip = "band_kizuna_creation_progress_tooltip"
					
					parentanchor = vcenter
						blockoverride "values" {
							value = "50"
						}
						#icon = {
						#	position = { -10 -25 }
						#	size = { 520 100 }
						#	texture = "gfx/interface/progressbar/cohesion_bar.dds"
						#}
					textbox = {
						parentanchor = center
