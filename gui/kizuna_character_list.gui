	# Band rosters use the same readable row rhythm as the character growth list:
	# role control, portrait, details, then a single removal action.
	type tot_band_role_member_row_base = widget {
		size = { 500 132 }
		datacontext = "[Scope.AccessCharacter]"
		visible = "[Scope.AccessCharacter.IsValid]"
		hbox = {
			margin = { 8 8 }
			spacing = 10
			block "role_button" { widget = { size = { 84 116 } } }
			widget = {
				 size = { 110 110 }
				character_portrait_large = { parentanchor = center blockoverride "show_hat" {} blockoverride "highlight" {} blockoverride "rank_icon" {} blockoverride "additional_icons" {} }
				widget = {
					visible = "[Character.GetInterestGroup.IsValid]"
					parentanchor = bottom|left
					position = { -7 2 }
					size = { 38 38 }
					datacontext = "[Character.GetInterestGroup]"
					icon = { parentanchor = center size = { 36 36 } texture = "[InterestGroup.GetTexture]" tooltipwidget = { FancyTooltip_IG = {} } }
				}
				widget = {
					parentanchor = bottom|right
					position = { 7 2 }
					size = { 38 38 }
					datacontext = "[Character.GetIdeology]"
					icon = { parentanchor = center size = { 36 36 } texture = "[Ideology.GetTexture]" tooltipwidget = { FancyTooltip_Ideology = {} } }
				}
			}
			vbox = {
				size = { 200 110 }
				spacing = 3
				textbox = { size = { 200 26 } text = "[Character.GetFullNameNoFormatting]" default_format = "#v" using = fontsize_medium align = left|nobaseline elide = right }
				block "role_summary" { textbox = { size = { 200 22 } text = "TOT_BAND_ROLE_NONE" using = fontsize_small align = left|nobaseline } }
				textbox = { visible = "[GetScriptedGui('tot_band_character_has_specialty').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 200 18 } raw_text = "特长：[Character.GetCustom('tot_band_specialty_summary')]" using = fontsize_very_small align = left|nobaseline elide = right }
			}
			vbox = {
				size = { 70 110 }
				button_standard = { text = "TOT_BAND_REMOVE" size = { 70 40 } enabled = "[GetScriptedGui('tot_band_remove_character').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]" onclick = "[GetScriptedGui('tot_band_remove_character').Execute(GuiScope.SetRoot(Character.MakeScope).End)]" tooltip = "[GetScriptedGui('tot_band_remove_character').IsValidTooltip(GuiScope.SetRoot(Character.MakeScope).End)]" }
			}
		}
	}

