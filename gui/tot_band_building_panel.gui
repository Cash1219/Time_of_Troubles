types building_panels
{
	type tot_band_headquarter_management = widget {
		size = { 420 120 }
		parentanchor = hcenter

		background = {
			using = default_background
			margin = { 8 8 }
		}

		flowcontainer = {
			direction = vertical
			spacing = 8
			margin = { 10 10 }

			state = {
				name = refresh_band_hq_lists
				trigger_on_create = yes
				on_finish = "[GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			textbox = {
				size = { 376 24 }
				text = "TOT_BAND_BUILDING_PANEL_LABEL"
				using = fontsize_medium
				align = left|nobaseline
			}

			textbox = {
				visible = "[Or(GetScriptedGui('tot_band_hq_state_bound_1').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_2').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_3').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_4').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_5').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_6').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_7').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_8').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_9').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End), GetScriptedGui('tot_band_hq_state_bound_10').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End))]"
				size = { 376 24 }
				text = "TOT_BAND_BOUND_NAME_LABEL"
				using = fontsize_small
				align = left|nobaseline
			}

			textbox = {
				visible = "[GetScriptedGui('tot_band_hq_state_bound_1').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				size = { 376 28 }
				text = "TOT_BAND_1_NAME_LABEL"
				using = fontsize_medium
				align = left|nobaseline
			}

			textbox = {
				visible = "[GetScriptedGui('tot_band_hq_state_bound_2').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				size = { 376 28 }
				text = "TOT_BAND_2_NAME_LABEL"
				using = fontsize_medium
				align = left|nobaseline
			}

			textbox = {
				visible = "[GetScriptedGui('tot_band_hq_state_bound_3').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				size = { 376 28 }
				text = "TOT_BAND_3_NAME_LABEL"
				using = fontsize_medium
				align = left|nobaseline
			}
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_4').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_4_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_5').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_5_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_6').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_6_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_7').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_7_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_8').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_8_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_9').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_9_NAME_LABEL" using = fontsize_medium align = left|nobaseline }
			textbox = { visible = "[GetScriptedGui('tot_band_hq_state_bound_10').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]" size = { 376 28 } text = "TOT_BAND_10_NAME_LABEL" using = fontsize_medium align = left|nobaseline }

			textbox = {
				visible = "[GetScriptedGui('tot_band_hq_state_unbound').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				size = { 376 24 }
				text = "TOT_BAND_UNBOUND_LABEL"
				using = fontsize_medium
				align = left|nobaseline
			}

			flowcontainer = {
				visible = "[GetScriptedGui('tot_band_hq_state_unbound').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				direction = vertical
				spacing = 4

				button = {
					visible = "[GetScriptedGui('tot_band_hq_state_create').IsValid(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
					using = default_button_primary
					size = { 376 30 }
					onclick = "[GetScriptedGui('tot_band_hq_state_create').Execute(GuiScope.SetRoot(Building.AccessState.MakeScope).End)][GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = "TOT_BAND_CREATE"
					tooltip = "TOT_BAND_CREATE_HINT"
				}

				flowcontainer = {
					spacing = 4
					button = {
						visible = "[GetScriptedGui('tot_band_hq_state_bind_1').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
						using = default_button
						size = { 120 28 }
						onclick = "[GetScriptedGui('tot_band_hq_state_bind_1').Execute(GuiScope.SetRoot(Building.AccessState.MakeScope).End)][GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text = "TOT_BAND_1_NAME_LABEL"
					}
					button = {
						visible = "[GetScriptedGui('tot_band_hq_state_bind_2').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
						using = default_button
						size = { 120 28 }
						onclick = "[GetScriptedGui('tot_band_hq_state_bind_2').Execute(GuiScope.SetRoot(Building.AccessState.MakeScope).End)][GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text = "TOT_BAND_2_NAME_LABEL"
					}
					button = {
						visible = "[GetScriptedGui('tot_band_hq_state_bind_3').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
						using = default_button
						size = { 120 28 }
						onclick = "[GetScriptedGui('tot_band_hq_state_bind_3').Execute(GuiScope.SetRoot(Building.AccessState.MakeScope).End)][GetScriptedGui('tot_kizuna_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text = "TOT_BAND_3_NAME_LABEL"
					}
				}
			}
		}
	}
}
