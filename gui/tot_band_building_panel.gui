				visible = "[GetScriptedGui('tot_band_hq_state_bound_3').IsShown(GuiScope.SetRoot(Building.AccessState.MakeScope).End)]"
				spacing = 5
				button = { visible = "[GetScriptedGui('tot_band_3_role_guitarist_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = default_button_primary size = { 124 36 } onclick = "[GetScriptedGui('tot_band_3_select_role_guitarist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text = "TOT_BAND_SLOT_GUITAR" }
